<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Geodetic Knife</title>
<meta name="description" content="Ghana Geodetic Transformation Tool - WGS84, GNG, GMG">
<meta name="theme-color" content="#5A8A5A">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="GeoKnife">
<link rel="manifest" href="/manifest.json">
<link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">
<link rel="apple-touch-icon" href="/icons/icon-192.png">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#141414;--card:#191919;--border:#252525;--border-light:#333;
  --text:#D0D0D0;--muted:#888;--dim:#555;--accent:#5A8A5A;--accent-dim:#3d5e3d;
  --red:#a04040;--red-dim:#6b2d2d;
  --radius:6px;--font-mono:'SF Mono','Fira Code','Cascadia Code',Consolas,monospace;
  --font-ui:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
}
html{font-size:14px}
body{background:var(--bg);color:var(--text);font-family:var(--font-ui);line-height:1.5;min-height:100vh;display:flex;flex-direction:column}
a{color:var(--accent);text-decoration:none}

/* ─── HEADER ─── */
.header{display:flex;align-items:center;justify-content:space-between;padding:.75rem 1.25rem;border-bottom:1px solid var(--border);background:var(--card);flex-shrink:0}
.header-left{display:flex;align-items:center;gap:.6rem}
.badge{background:var(--accent);color:#fff;font-weight:700;font-size:.75rem;padding:.2rem .55rem;border-radius:3px;letter-spacing:.04em}
.header-title{font-size:1rem;font-weight:600;color:var(--text)}
.header-right{display:flex;align-items:center;gap:.4rem}
.hdr-btn{background:none;border:1px solid var(--border);color:var(--muted);cursor:pointer;padding:.35rem .55rem;border-radius:var(--radius);display:flex;align-items:center;gap:.3rem;font-size:.78rem;font-family:var(--font-ui);transition:all .15s}
.hdr-btn:hover{border-color:var(--accent);color:var(--text)}
.hdr-btn.active{border-color:var(--accent);color:var(--accent);background:rgba(90,138,90,.1)}
.datum-dot{width:8px;height:8px;border-radius:50%;background:var(--accent);margin-left:.3rem;flex-shrink:0}
.datum-label{font-size:.72rem;color:var(--dim);margin-left:.15rem}

/* ─── DROPDOWN ─── */
.dropdown-wrap{position:relative}
.dropdown-menu{display:none;position:absolute;top:calc(100% + 4px);right:0;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);min-width:280px;max-height:360px;overflow-y:auto;z-index:100;box-shadow:0 8px 24px rgba(0,0,0,.5)}
.dropdown-menu.open{display:block}
.dropdown-header{padding:.5rem .7rem;font-size:.72rem;color:var(--dim);border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}
.dropdown-item{padding:.45rem .7rem;border-bottom:1px solid var(--border);cursor:pointer;transition:background .1s}
.dropdown-item:last-child{border-bottom:none}
.dropdown-item:hover{background:rgba(90,138,90,.08)}
.dropdown-item .di-time{font-size:.65rem;color:var(--dim);margin-bottom:.15rem}
.dropdown-item .di-coords{font-family:var(--font-mono);font-size:.78rem;color:var(--text)}
.dropdown-item .di-name{font-size:.78rem;color:var(--text);display:flex;align-items:center;justify-content:space-between}
.dropdown-item .di-delete{color:var(--dim);cursor:pointer;padding:0 .2rem;border:none;background:none;font-size:.85rem;line-height:1}
.dropdown-item .di-delete:hover{color:var(--red)}
.dropdown-empty{padding:1rem .7rem;color:var(--dim);font-size:.8rem;text-align:center}

/* ─── SETTINGS PANEL ─── */
.settings-panel{display:none;background:var(--card);border-bottom:1px solid var(--border);padding:.7rem 1.25rem}
.settings-panel.open{display:flex;flex-wrap:wrap;align-items:center;gap:1.2rem}
.setting-group{display:flex;align-items:center;gap:.4rem;font-size:.78rem;color:var(--muted)}
.setting-group label{white-space:nowrap}
.toggle-group{display:flex;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}
.toggle-group button{background:none;border:none;color:var(--muted);padding:.25rem .6rem;font-size:.75rem;cursor:pointer;font-family:var(--font-ui);transition:all .15s}
.toggle-group button.active{background:var(--accent-dim);color:var(--text)}
.setting-input{background:var(--bg);border:1px solid var(--border);color:var(--text);padding:.2rem .4rem;border-radius:var(--radius);width:2.5rem;font-size:.78rem;font-family:var(--font-mono);text-align:center}

/* ─── TABS ─── */
.tabs{display:flex;border-bottom:1px solid var(--border);background:var(--card);flex-shrink:0}
.tab-btn{flex:1;background:none;border:none;color:var(--muted);padding:.6rem .5rem;font-size:.82rem;cursor:pointer;font-family:var(--font-ui);transition:all .15s;border-bottom:2px solid transparent}
.tab-btn:hover{color:var(--text);background:rgba(255,255,255,.02)}
.tab-btn.active{color:var(--accent);border-bottom-color:var(--accent)}

/* ─── MAIN LAYOUT ─── */
.main-wrap{flex:1;padding:.75rem;display:flex;gap:.75rem;overflow-y:auto}
@media(max-width:768px){.main-wrap{flex-direction:column}}
.panel{flex:1;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:.85rem;display:flex;flex-direction:column}
.panel-label{font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;color:var(--dim);margin-bottom:.6rem}

/* ─── DMS HELPER ─── */
.dms-toggle-wrap{display:flex;align-items:center;gap:.5rem;margin-bottom:.5rem}
.dms-toggle{font-size:.75rem;color:var(--muted);background:none;border:1px solid var(--border);padding:.2rem .5rem;border-radius:var(--radius);cursor:pointer;font-family:var(--font-ui);transition:all .15s}
.dms-toggle:hover,.dms-toggle.active{border-color:var(--accent);color:var(--accent)}
.dms-fields{display:none;grid-template-columns:repeat(7,1fr);gap:.35rem;margin-bottom:.6rem}
.dms-fields.open{display:grid}
.dms-field-group{display:flex;flex-direction:column;gap:.15rem}
.dms-field-group label{font-size:.6rem;color:var(--dim);text-transform:uppercase}
.dms-field-group select,.dms-field-group input{background:var(--bg);border:1px solid var(--border);color:var(--text);padding:.3rem .25rem;border-radius:var(--radius);font-family:var(--font-mono);font-size:.8rem;width:100%;text-align:center}
.dms-field-group select{cursor:pointer}

/* ─── INPUT ROW ─── */
.input-row{display:flex;gap:.5rem;margin-bottom:.5rem}
.input-group{flex:1;display:flex;flex-direction:column;gap:.15rem}
.input-group label{font-size:.7rem;color:var(--muted);font-weight:500}
.input-group input{background:var(--bg);border:1px solid var(--border);color:var(--text);padding:.5rem .6rem;border-radius:var(--radius);font-family:var(--font-mono);font-size:.92rem;outline:none;transition:border-color .15s}
.input-group input:focus{border-color:var(--accent)}
.input-group input.error{border-color:var(--red)}
.input-group input::placeholder{color:var(--dim)}
.grid-type-toggle{display:flex;gap:.5rem;margin-bottom:.6rem}
.grid-type-btn{flex:1;background:none;border:1px solid var(--border);color:var(--muted);padding:.35rem;border-radius:var(--radius);cursor:pointer;font-family:var(--font-ui);font-size:.78rem;text-align:center;transition:all .15s}
.grid-type-btn.active{border-color:var(--accent);color:var(--accent);background:rgba(90,138,90,.08)}
.convert-btn{width:100%;background:var(--accent);color:#fff;border:none;padding:.6rem;border-radius:var(--radius);font-size:.88rem;font-weight:600;cursor:pointer;font-family:var(--font-ui);transition:all .15s;margin-top:.3rem}
.convert-btn:hover{background:#4e7a4e}
.convert-btn:active{transform:scale(.98)}
.convert-btn:disabled{opacity:.5;cursor:not-allowed}
.error-msg{color:var(--red);font-size:.78rem;margin-top:.35rem;display:none}
.error-msg.show{display:block}

/* ─── OUTPUT CARDS ─── */
.accuracy-info{font-size:.68rem;color:var(--dim);margin-bottom:.6rem;line-height:1.6}
.result-card{background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);padding:.6rem .7rem;margin-bottom:.45rem;position:relative}
.result-card-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:.25rem}
.result-card-title{font-size:.72rem;color:var(--accent);font-weight:600;text-transform:uppercase;letter-spacing:.04em}
.result-card-actions{display:flex;align-items:center;gap:.2rem}
.result-row{display:flex;align-items:center;gap:.4rem;font-family:var(--font-mono);font-size:.85rem;color:var(--text);cursor:pointer;padding:.15rem 0;border-radius:3px;transition:background .1s}
.result-row:hover{background:rgba(255,255,255,.03)}
.result-row-label{font-size:.68rem;color:var(--muted);font-family:var(--font-ui);min-width:1.2rem}
.icon-btn{background:none;border:none;color:var(--dim);cursor:pointer;padding:.15rem;border-radius:3px;display:flex;align-items:center;transition:all .15s}
.icon-btn:hover{color:var(--text)}
.icon-btn.copied{color:var(--accent)}
.icon-btn.bookmarked{color:#d4a843}
.divider{height:1px;background:var(--border);margin:.5rem 0}
.meta-line{font-size:.78rem;color:var(--muted);display:flex;align-items:center;gap:.4rem;padding:.2rem 0}
.meta-line .label{color:var(--dim);font-size:.68rem;min-width:3.5rem}
.meta-line .value{font-family:var(--font-mono);color:var(--text)}
.meta-line.loading{color:var(--dim)}
.spinner{display:inline-block;width:12px;height:12px;border:2px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin .6s linear infinite;margin-right:.3rem}
@keyframes spin{to{transform:rotate(360deg)}}

/* ─── AZIMUTH SECTION ─── */
.azimuth-section{margin-top:.5rem;border-top:1px solid var(--border);padding-top:.5rem}
.azimuth-toggle{width:100%;background:none;border:none;color:var(--muted);font-size:.78rem;cursor:pointer;font-family:var(--font-ui);display:flex;align-items:center;gap:.3rem;padding:.25rem 0;transition:color .15s}
.azimuth-toggle:hover{color:var(--text)}
.azimuth-toggle svg{transition:transform .2s}
.azimuth-toggle.open svg{transform:rotate(90deg)}
.azimuth-body{display:none;padding-top:.5rem}
.azimuth-body.open{display:block}
.azimuth-inputs{display:grid;grid-template-columns:1fr 1fr;gap:.5rem}
.az-input-group{display:flex;flex-direction:column;gap:.15rem}
.az-input-group label{font-size:.68rem;color:var(--dim)}
.az-input-group input{background:var(--bg);border:1px solid var(--border);color:var(--text);padding:.35rem .4rem;border-radius:var(--radius);font-family:var(--font-mono);font-size:.8rem;outline:none;transition:border-color .15s}
.az-input-group input:focus{border-color:var(--accent)}
.az-point-label{font-size:.72rem;color:var(--accent);font-weight:600;margin-bottom:.2rem;grid-column:1/-1}
.az-calc-btn{grid-column:1/-1;margin-top:.3rem;background:none;border:1px solid var(--border);color:var(--muted);padding:.4rem;border-radius:var(--radius);cursor:pointer;font-family:var(--font-ui);font-size:.78rem;transition:all .15s}
.az-calc-btn:hover{border-color:var(--accent);color:var(--text)}
.az-results{margin-top:.5rem;display:none}
.az-results.show{display:block}
.az-result-row{font-size:.78rem;color:var(--muted);display:flex;justify-content:space-between;padding:.15rem 0}
.az-result-row .azr-val{font-family:var(--font-mono);color:var(--text)}

/* ─── ACTIONS ROW ─── */
.actions{padding:.6rem .75rem;display:flex;flex-wrap:wrap;gap:.4rem;border-top:1px solid var(--border);background:var(--card);flex-shrink:0}
.action-btn{background:none;border:1px solid var(--border);color:var(--muted);padding:.35rem .6rem;border-radius:var(--radius);cursor:pointer;font-family:var(--font-ui);font-size:.75rem;display:flex;align-items:center;gap:.3rem;transition:all .15s}
.action-btn:hover{border-color:var(--accent);color:var(--text)}
.action-btn.import-active{border-color:var(--accent);color:var(--accent)}
.import-info{font-size:.72rem;color:var(--dim);display:flex;align-items:center;gap:.3rem}

/* ─── FOOTER ─── */
.footer{padding:.5rem 1.25rem;border-top:1px solid var(--border);text-align:center;font-size:.68rem;color:var(--dim);flex-shrink:0;background:var(--card)}

/* ─── TOAST ─── */
.toast{position:fixed;top:1rem;left:50%;transform:translateX(-50%) translateY(-120%);background:var(--card);border:1px solid var(--border);color:var(--text);padding:.5rem 1rem;border-radius:var(--radius);font-size:.82rem;z-index:1000;transition:transform .25s ease;box-shadow:0 4px 16px rgba(0,0,0,.4);white-space:nowrap}
.toast.show{transform:translateX(-50%) translateY(0)}
.toast.error{border-color:var(--red);color:#e08080}

/* ─── BATCH TABLE ─── */
.batch-table-wrap{display:none;margin-top:.6rem;max-height:250px;overflow:auto;border:1px solid var(--border);border-radius:var(--radius)}
.batch-table-wrap.show{display:block}
.batch-table{width:100%;border-collapse:collapse;font-size:.72rem}
.batch-table th{position:sticky;top:0;background:var(--card);color:var(--dim);font-weight:600;text-align:left;padding:.3rem .5rem;border-bottom:1px solid var(--border)}
.batch-table td{padding:.25rem .5rem;border-bottom:1px solid var(--border);font-family:var(--font-mono);color:var(--muted)}
.batch-table tr:hover td{color:var(--text);background:rgba(255,255,255,.02)}

/* ─── BOOKMARK NAME INPUT ─── */
.bm-name-input{background:var(--bg);border:1px solid var(--accent);color:var(--text);padding:.15rem .3rem;border-radius:3px;font-size:.75rem;font-family:var(--font-ui);width:140px;outline:none}
</style>
</head>
<body>

<!-- ═══════ TOAST ═══════ -->
<div class="toast" id="toast"></div>

<!-- ═══════ HEADER ═══════ -->
<header class="header">
  <div class="header-left">
    <span class="badge">GH</span>
    <span class="header-title">Geodetic Tool</span>
  </div>
  <div class="header-right">
    <!-- History -->
    <div class="dropdown-wrap">
      <button class="hdr-btn" id="historyBtn" title="Session History">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        History
      </button>
      <div class="dropdown-menu" id="historyDropdown">
        <div class="dropdown-header">
          <span>Recent Conversions</span>
          <button class="icon-btn" id="clearHistoryBtn" title="Clear all history" style="font-size:.7rem;color:var(--dim)">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
          </button>
        </div>
        <div id="historyList"></div>
      </div>
    </div>
    <!-- Bookmarks -->
    <div class="dropdown-wrap">
      <button class="hdr-btn" id="bookmarksBtn" title="Bookmarks">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        Bookmarks
      </button>
      <div class="dropdown-menu" id="bookmarksDropdown">
        <div class="dropdown-header"><span>Saved Points</span></div>
        <div id="bookmarksList"></div>
      </div>
    </div>
    <!-- Settings -->
    <button class="hdr-btn" id="settingsBtn" title="Settings">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
    </button>
    <div class="datum-dot" title="Accra Datum active"></div>
    <span class="datum-label">Accra Datum</span>
  </div>
</header>

<!-- ═══════ SETTINGS PANEL ═══════ -->
<div class="settings-panel" id="settingsPanel">
  <div class="setting-group">
    <label>Format:</label>
    <div class="toggle-group">
      <button class="active" data-fmt="dd">DD</button>
      <button data-fmt="dms">DMS</button>
    </div>
  </div>
  <div class="setting-group">
    <label>Grid dec:</label>
    <input type="number" class="setting-input" id="gridDecimals" value="3" min="0" max="10">
  </div>
  <div class="setting-group">
    <label>Geo dec:</label>
    <input type="number" class="setting-input" id="geoDecimals" value="8" min="4" max="12">
  </div>
</div>

<!-- ═══════ TABS ═══════ -->
<div class="tabs">
  <button class="tab-btn active" data-tab="wgs84_to_grid">WGS 84 &rarr; Grid</button>
  <button class="tab-btn" data-tab="gng_gmg">GNG &harr; GMG</button>
  <button class="tab-btn" data-tab="grid_to_wgs84">Grid &rarr; WGS 84</button>
</div>

<!-- ═══════ MAIN ═══════ -->
<div class="main-wrap">
  <!-- LEFT: INPUT -->
  <div class="panel" id="inputPanel">
    <div class="panel-label">Input</div>

    <!-- DMS Entry Helper (WGS84 mode only) -->
    <div class="dms-toggle-wrap" id="dmsToggleWrap">
      <button class="dms-toggle" id="dmsToggle">DMS Entry</button>
    </div>
    <div class="dms-fields" id="dmsFields">
      <div class="dms-field-group"><label>Lat&deg;</label><input type="number" id="dmsLatDeg" placeholder="5"></div>
      <div class="dms-field-group"><label>Lat&prime;</label><input type="number" id="dmsLatMin" placeholder="36" min="0" max="59"></div>
      <div class="dms-field-group"><label>Lat&Prime;</label><input type="number" id="dmsLatSec" placeholder="0" min="0" max="59.9999" step="0.1"></div>
      <div class="dms-field-group"><label>NS</label><select id="dmsLatNS"><option value="N">N</option><option value="S">S</option></select></div>
      <div class="dms-field-group"><label>Lon&deg;</label><input type="number" id="dmsLonDeg" placeholder="0"></div>
      <div class="dms-field-group"><label>Lon&prime;</label><input type="number" id="dmsLonMin" placeholder="12" min="0" max="59"></div>
      <div class="dms-field-group"><label>Lon&Prime;</label><input type="number" id="dmsLonSec" placeholder="0" min="0" max="59.9999" step="0.1"></div>
    </div>

    <!-- WGS84 inputs (tab 0) -->
    <div id="wgs84Inputs">
      <div class="input-row">
        <div class="input-group">
          <label>LATITUDE</label>
          <input type="text" id="inputLat" placeholder="5.6037" step="any">
        </div>
        <div class="input-group">
          <label>LONGITUDE</label>
          <input type="text" id="inputLon" placeholder="-0.1870" step="any">
        </div>
      </div>
    </div>

    <!-- Grid inputs (tab 1 & 2) -->
    <div id="gridInputs" style="display:none">
      <div class="grid-type-toggle">
        <button class="grid-type-btn active" data-crs="GNG">GNG (ft)</button>
        <button class="grid-type-btn" data-crs="GMG">GMG (m)</button>
      </div>
      <div class="input-row">
        <div class="input-group">
          <label>EASTING</label>
          <input type="text" id="inputEasting" placeholder="725412.4567" step="any">
        </div>
        <div class="input-group">
          <label>NORTHING</label>
          <input type="text" id="inputNorthing" placeholder="668321.1234" step="any">
        </div>
      </div>
    </div>

    <button class="convert-btn" id="convertBtn">Convert</button>
    <div class="error-msg" id="errorMsg"></div>

    <!-- Batch table (shown after CSV import) -->
    <div class="batch-table-wrap" id="batchTableWrap">
      <table class="batch-table" id="batchTable">
        <thead><tr><th>#</th><th>GNG E</th><th>GNG N</th><th>GMG E</th><th>GMG N</th><th>Lat</th><th>Lon</th></tr></thead>
        <tbody id="batchTableBody"></tbody>
      </table>
    </div>
    <div class="import-info" id="importInfo" style="display:none"></div>
  </div>

  <!-- RIGHT: OUTPUT -->
  <div class="panel" id="outputPanel">
    <div class="panel-label">Output</div>

    <!-- Accuracy info -->
    <div class="accuracy-info" id="accuracyInfo" style="display:none">
      <div id="accH"></div>
      <div id="accG"></div>
    </div>

    <!-- GNG Result -->
    <div class="result-card" id="gngCard" style="display:none">
      <div class="result-card-header">
        <span class="result-card-title">GNG &mdash; Gold Coast Grid (ft)</span>
        <div class="result-card-actions">
          <button class="icon-btn" id="bookmarkGng" title="Bookmark this point">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </button>
          <button class="icon-btn copy-btn" data-copy="gng" title="Copy GNG coordinates">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
          </button>
        </div>
      </div>
      <div class="result-row" data-copy="gngE" title="Click to copy">
        <span class="result-row-label">E</span>
        <span class="result-value" id="gngE">&mdash;</span>
      </div>
      <div class="result-row" data-copy="gngN" title="Click to copy">
        <span class="result-row-label">N</span>
        <span class="result-value" id="gngN">&mdash;</span>
      </div>
    </div>

    <!-- GMG Result -->
    <div class="result-card" id="gmgCard" style="display:none">
      <div class="result-card-header">
        <span class="result-card-title">GMG &mdash; Ghana Metre Grid (m)</span>
        <div class="result-card-actions">
          <button class="icon-btn copy-btn" data-copy="gmg" title="Copy GMG coordinates">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
          </button>
        </div>
      </div>
      <div class="result-row" data-copy="gmgE" title="Click to copy">
        <span class="result-row-label">E</span>
        <span class="result-value" id="gmgE">&mdash;</span>
      </div>
      <div class="result-row" data-copy="gmgN" title="Click to copy">
        <span class="result-row-label">N</span>
        <span class="result-value" id="gmgN">&mdash;</span>
      </div>
    </div>

    <div class="divider"></div>

    <!-- WGS84 Result -->
    <div class="result-card" id="wgs84Card" style="display:none">
      <div class="result-card-header">
        <span class="result-card-title">WGS 84</span>
        <div class="result-card-actions">
          <button class="icon-btn copy-btn" data-copy="wgs84" title="Copy WGS84 coordinates">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
          </button>
        </div>
      </div>
      <div class="result-row" data-copy="wgsLat" title="Click to copy">
        <span class="result-row-label">LAT</span>
        <span class="result-value" id="wgsLat">&mdash;</span>
      </div>
      <div class="result-row" data-copy="wgsLon" title="Click to copy">
        <span class="result-row-label">LON</span>
        <span class="result-value" id="wgsLon">&mdash;</span>
      </div>
      <div class="result-row" id="wgsDmsRow" data-copy="wgsDms" title="Click to copy DMS" style="display:none">
        <span class="result-row-label">DMS</span>
        <span class="result-value" id="wgsDms">&mdash;</span>
      </div>
    </div>

    <!-- Elevation (Feature 1) -->
    <div class="meta-line" id="elevLine" style="display:none">
      <span class="label">ELEV</span>
      <span class="value" id="elevValue">&mdash;</span>
    </div>

    <!-- Geocode (Feature 2) -->
    <div class="meta-line" id="geocodeLine" style="display:none">
      <span class="label">Near</span>
      <span class="value" id="geocodeValue">&mdash;</span>
    </div>

    <!-- ═══ AZIMUTH & DISTANCE (Feature 9) ═══ -->
    <div class="azimuth-section" id="azimuthSection">
      <button class="azimuth-toggle" id="azimuthToggle">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="9 18 15 12 9 6"/></svg>
        Azimuth &amp; Distance
      </button>
      <div class="azimuth-body" id="azimuthBody">
        <div class="azimuth-inputs">
          <span class="az-point-label">Point A</span>
          <div class="az-input-group"><label>Lat</label><input type="text" id="azLat1" placeholder="5.6037"></div>
          <div class="az-input-group"><label>Lon</label><input type="text" id="azLon1" placeholder="-0.1870"></div>
          <span class="az-point-label">Point B</span>
          <div class="az-input-group"><label>Lat</label><input type="text" id="azLat2" placeholder="5.5500"></div>
          <div class="az-input-group"><label>Lon</label><input type="text" id="azLon2" placeholder="-0.2200"></div>
          <button class="az-calc-btn" id="azCalcBtn">Calculate</button>
        </div>
        <div class="az-results" id="azResults">
          <div class="az-result-row"><span>Distance</span><span class="azr-val" id="azDist">&mdash;</span></div>
          <div class="az-result-row"><span>Distance (ft)</span><span class="azr-val" id="azDistFt">&mdash;</span></div>
          <div class="az-result-row"><span>Initial Bearing</span><span class="azr-val" id="azBear1">&mdash;</span></div>
          <div class="az-result-row"><span>Final Bearing</span><span class="azr-val" id="azBear2">&mdash;</span></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════ ACTIONS ROW ═══════ -->
<div class="actions">
  <input type="file" id="csvFileInput" accept=".csv" style="display:none">
  <button class="action-btn" id="importCsvBtn">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
    Import CSV
  </button>
  <button class="action-btn" id="exportCsvBtn">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
    CSV
  </button>
  <button class="action-btn" id="exportKmlBtn">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
    KML
  </button>
  <button class="action-btn" id="exportGeoJsonBtn">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
    GeoJSON
  </button>
  <button class="action-btn" id="clearBtn">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
    Clear
  </button>
</div>

<!-- ═══════ FOOTER ═══════ -->
<footer class="footer">
  EPSG:2136 &middot; War Office a 6,378,300 &middot; 1/f 296 &middot; TM k&#8320; 0.99975 &middot; CM 1&deg;W &middot; towgs84 &minus;199 32 322
</footer>

<script>
(function(){
"use strict";

/* ═══════════════════════════════════════════════════════════════════════
   STATE
   ═══════════════════════════════════════════════════════════════════════ */
var state = {
  tab: "wgs84_to_grid",
  gridCrs: "GNG",
  format: "dd",        // dd or dms
  gridDec: 3,
  geoDec: 8,
  dmsEntry: false,
  lastResult: null,
  batchResults: [],
  elevCache: {},
  geocodeCache: {}
};

/* ═══════════════════════════════════════════════════════════════════════
   DOM REFS
   ═══════════════════════════════════════════════════════════════════════ */
var $ = function(sel){ return document.querySelector(sel); };
var $$ = function(sel){ return document.querySelectorAll(sel); };

var inputLat = $("#inputLat"), inputLon = $("#inputLon");
var inputEasting = $("#inputEasting"), inputNorthing = $("#inputNorthing");
var convertBtn = $("#convertBtn"), errorMsg = $("#errorMsg");
var wgs84Inputs = $("#wgs84Inputs"), gridInputs = $("#gridInputs");
var dmsToggleWrap = $("#dmsToggleWrap"), dmsToggle = $("#dmsToggle"), dmsFields = $("#dmsFields");
var gngCard = $("#gngCard"), gmgCard = $("#gmgCard"), wgs84Card = $("#wgs84Card");
var gngE = $("#gngE"), gngN = $("#gngN");
var gmgE = $("#gmgE"), gmgN = $("#gmgN");
var wgsLat = $("#wgsLat"), wgsLon = $("#wgsLon"), wgsDms = $("#wgsDms"), wgsDmsRow = $("#wgsDmsRow");
var accuracyInfo = $("#accuracyInfo"), accH = $("#accH"), accG = $("#accG");
var elevLine = $("#elevLine"), elevValue = $("#elevValue");
var geocodeLine = $("#geocodeLine"), geocodeValue = $("#geocodeValue");
var toastEl = $("#toast");
var batchTableWrap = $("#batchTableWrap"), batchTableBody = $("#batchTableBody");
var importInfo = $("#importInfo");
var historyList = $("#historyList"), bookmarksList = $("#bookmarksList");
var csvFileInput = $("#csvFileInput");

/* DMS field refs */
var dmsLatDeg = $("#dmsLatDeg"), dmsLatMin = $("#dmsLatMin"), dmsLatSec = $("#dmsLatSec"), dmsLatNS = $("#dmsLatNS");
var dmsLonDeg = $("#dmsLonDeg"), dmsLonMin = $("#dmsLonMin"), dmsLonSec = $("#dmsLonSec");

/* Azimuth refs */
var azLat1 = $("#azLat1"), azLon1 = $("#azLon1"), azLat2 = $("#azLat2"), azLon2 = $("#azLon2");

/* ═══════════════════════════════════════════════════════════════════════
   UTILITIES
   ═══════════════════════════════════════════════════════════════════════ */
function toast(msg, isError){
  toastEl.textContent = msg;
  toastEl.className = "toast" + (isError ? " error" : "");
  // force reflow
  void toastEl.offsetWidth;
  toastEl.classList.add("show");
  clearTimeout(toastEl._t);
  toastEl._t = setTimeout(function(){ toastEl.classList.remove("show"); }, 2400);
}

function fmt(n, d){ return typeof n === "number" ? n.toFixed(d) : "\u2014"; }

function toDms(dd, posChar, negChar){
  if(typeof dd !== "number") return "\u2014";
  var dir = dd >= 0 ? posChar : negChar;
  dd = Math.abs(dd);
  var deg = Math.floor(dd);
  var min = Math.floor((dd - deg) * 60);
  var sec = ((dd - deg) * 60 - min) * 60;
  return deg + "\u00b0" + String(min).padStart(2,"0") + "\u2032" + sec.toFixed(4) + "\u2033" + dir;
}

function parseLatLon(val){
  if(val == null) return NaN;
  val = val.trim();
  // Handle DMS strings like 5°36'0"N
  var dmsMatch = val.match(/^\s*(-?\d+(?:\.\d+)?)\s*[°dD]\s*(\d+(?:\.\d+)?)\s*['mM]\s*(\d+(?:\.\d+)?)\s*["sS]\s*([NSEWnsew])?\s*$/);
  if(dmsMatch){
    var sign = 1;
    var dir = (dmsMatch[4] || "").toUpperCase();
    if(dir === "S" || dir === "W") sign = -1;
    var d = parseFloat(dmsMatch[1]), m = parseFloat(dmsMatch[2]), s = parseFloat(dmsMatch[3]);
    if(d < 0) { sign *= -1; d = Math.abs(d); }
    return sign * (d + m/60 + s/3600);
  }
  return parseFloat(val);
}

function downloadFile(filename, content, mime){
  var blob = new Blob([content], {type: mime || "text/plain"});
  var a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = filename;
  a.click();
  URL.revokeObjectURL(a.href);
}

function getHistory(){
  try { return JSON.parse(localStorage.getItem("gh_geodetic_history") || "[]"); }
  catch(e){ return []; }
}
function saveHistory(h){
  try { localStorage.setItem("gh_geodetic_history", JSON.stringify(h.slice(0, 30))); } catch(e){}
}
function getBookmarks(){
  try { return JSON.parse(localStorage.getItem("gh_geodetic_bookmarks") || "[]"); }
  catch(e){ return []; }
}
function saveBookmarks(b){
  try { localStorage.setItem("gh_geodetic_bookmarks", JSON.stringify(b)); } catch(e){}
}

/* ═══════════════════════════════════════════════════════════════════════
   TABS
   ═══════════════════════════════════════════════════════════════════════ */
$$(".tab-btn").forEach(function(btn){
  btn.addEventListener("click", function(){
    $$(".tab-btn").forEach(function(b){ b.classList.remove("active"); });
    btn.classList.add("active");
    state.tab = btn.dataset.tab;
    updateInputVisibility();
  });
});

function updateInputVisibility(){
  var isWgs84 = state.tab === "wgs84_to_grid";
  wgs84Inputs.style.display = isWgs84 ? "" : "none";
  gridInputs.style.display = isWgs84 ? "none" : "";
  dmsToggleWrap.style.display = isWgs84 ? "flex" : "none";
  if(!isWgs84){
    dmsFields.classList.remove("open");
    state.dmsEntry = false;
    dmsToggle.classList.remove("active");
  }
}

/* ═══════════════════════════════════════════════════════════════════════
   GRID CRS TOGGLE
   ═══════════════════════════════════════════════════════════════════════ */
$$(".grid-type-btn").forEach(function(btn){
  btn.addEventListener("click", function(){
    $$(".grid-type-btn").forEach(function(b){ b.classList.remove("active"); });
    btn.classList.add("active");
    state.gridCrs = btn.dataset.crs;
  });
});

/* ═══════════════════════════════════════════════════════════════════════
   SETTINGS
   ═══════════════════════════════════════════════════════════════════════ */
var settingsBtn = $("#settingsBtn");
settingsBtn.addEventListener("click", function(){
  $("#settingsPanel").classList.toggle("open");
  settingsBtn.classList.toggle("active");
});

// Format toggle
$$(".toggle-group button").forEach(function(btn){
  btn.addEventListener("click", function(){
    var siblings = btn.parentElement.children;
    for(var i=0;i<siblings.length;i++) siblings[i].classList.remove("active");
    btn.classList.add("active");
    state.format = btn.dataset.fmt;
    wgsDmsRow.style.display = (state.format === "dms") ? "" : "none";
    if(state.lastResult) displayResult(state.lastResult);
  });
});

$("#gridDecimals").addEventListener("change", function(){
  state.gridDec = Math.max(0, Math.min(10, parseInt(this.value) || 3));
  this.value = state.gridDec;
  if(state.lastResult) displayResult(state.lastResult);
});
$("#geoDecimals").addEventListener("change", function(){
  state.geoDec = Math.max(4, Math.min(12, parseInt(this.value) || 8));
  this.value = state.geoDec;
  if(state.lastResult) displayResult(state.lastResult);
});

/* ═══════════════════════════════════════════════════════════════════════
   DMS ENTRY HELPER (Feature 10)
   ═══════════════════════════════════════════════════════════════════════ */
dmsToggle.addEventListener("click", function(){
  state.dmsEntry = !state.dmsEntry;
  dmsFields.classList.toggle("open", state.dmsEntry);
  dmsToggle.classList.toggle("active", state.dmsEntry);
  if(state.dmsEntry) syncDmsFromDecimal();
});

function syncDmsFromDecimal(){
  var lat = parseFloat(inputLat.value);
  var lon = parseFloat(inputLon.value);
  if(isNaN(lat) || isNaN(lon)) return;
  var dir1 = lat >= 0 ? "N" : "S";
  lat = Math.abs(lat);
  var dir2 = lon >= 0 ? "E" : "W";
  lon = Math.abs(lon);
  dmsLatDeg.value = Math.floor(lat);
  dmsLatMin.value = Math.floor((lat % 1) * 60);
  dmsLatSec.value = (((lat % 1) * 60) % 1) * 60;
  dmsLatNS.value = dir1;
  dmsLonDeg.value = Math.floor(lon);
  dmsLonMin.value = Math.floor((lon % 1) * 60);
  dmsLonSec.value = (((lon % 1) * 60) % 1) * 60;
}

function syncDecimalFromDms(){
  var d1 = parseFloat(dmsLatDeg.value) || 0;
  var m1 = parseFloat(dmsLatMin.value) || 0;
  var s1 = parseFloat(dmsLatSec.value) || 0;
  var dir1 = dmsLatNS.value;
  var lat = d1 + m1/60 + s1/3600;
  if(dir1 === "S") lat = -lat;
  var d2 = parseFloat(dmsLonDeg.value) || 0;
  var m2 = parseFloat(dmsLonMin.value) || 0;
  var s2 = parseFloat(dmsLonSec.value) || 0;
  var lon = d2 + m2/60 + s2/3600;
  // Assume negative longitude for Ghana (west of Greenwich)
  if(lon > 0) lon = -lon;
  inputLat.value = lat.toFixed(8);
  inputLon.value = lon.toFixed(8);
}

// DMS fields → decimal
[dmsLatDeg, dmsLatMin, dmsLatSec, dmsLatNS, dmsLonDeg, dmsLonMin, dmsLonSec].forEach(function(el){
  el.addEventListener("input", syncDecimalFromDms);
  el.addEventListener("change", syncDecimalFromDms);
});

// Decimal → DMS (clear DMS when editing decimal directly)
inputLat.addEventListener("input", function(){
  if(state.dmsEntry){
    dmsLatDeg.value = ""; dmsLatMin.value = ""; dmsLatSec.value = "";
  }
});
inputLon.addEventListener("input", function(){
  if(state.dmsEntry){
    dmsLonDeg.value = ""; dmsLonMin.value = ""; dmsLonSec.value = "";
  }
});

/* ═══════════════════════════════════════════════════════════════════════
   CONVERSION
   ═══════════════════════════════════════════════════════════════════════ */
convertBtn.addEventListener("click", doConvert);

// Also convert on Enter in input fields
[inputLat, inputLon, inputEasting, inputNorthing].forEach(function(el){
  el.addEventListener("keydown", function(e){ if(e.key === "Enter"){ e.preventDefault(); doConvert(); } });
});

async function doConvert(){
  errorMsg.classList.remove("show");
  errorMsg.textContent = "";
  clearErrorStyles();
  var body = {};
  var mode = "";

  if(state.tab === "wgs84_to_grid"){
    var lat = parseLatLon(inputLat.value);
    var lon = parseLatLon(inputLon.value);
    if(isNaN(lat) || isNaN(lon)){
      showError("Enter valid latitude and longitude.");
      return;
    }
    if(lat < -90 || lat > 90){ showError("Latitude must be between -90 and 90."); return; }
    if(lon < -180 || lon > 180){ showError("Longitude must be between -180 and 180."); return; }
    mode = "WGS84_TO_GRID";
    body = { mode: mode, lat: lat, lon: lon };
  } else {
    var e = parseFloat(inputEasting.value);
    var n = parseFloat(inputNorthing.value);
    if(isNaN(e) || isNaN(n)){
      showError("Enter valid easting and northing.");
      return;
    }
    mode = state.tab === "gng_gmg" ? "GNG_GMG" : "GRID_TO_WGS84";
    body = { mode: mode, easting: e, northing: n, from_crs: state.gridCrs };
  }

  convertBtn.disabled = true;
  convertBtn.textContent = "Converting\u2026";
  try {
    var res = await fetch("/api/convert", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body)
    });
    var data = await res.json();
    if(!res.ok){
      showError(data.error || "Conversion failed (HTTP " + res.status + ")");
      return;
    }
    state.lastResult = data;
    state.batchResults = [data];
    displayResult(data);
    addToHistory(body, data);
    fetchElevation(data.wgs84.lat, data.wgs84.lon);
    fetchGeocode(data.wgs84.lat, data.wgs84.lon);
    prefillAzPointA(data.wgs84.lat, data.wgs84.lon);
    batchTableWrap.classList.remove("show");
    importInfo.style.display = "none";
    toast("Conversion complete");
  } catch(err){
    showError("Network error: " + err.message);
  } finally {
    convertBtn.disabled = false;
    convertBtn.textContent = "Convert";
  }
}

function showError(msg){
  errorMsg.textContent = msg;
  errorMsg.classList.add("show");
  toast(msg, true);
}

function clearErrorStyles(){
  [inputLat, inputLon, inputEasting, inputNorthing].forEach(function(el){ el.classList.remove("error"); });
}

function displayResult(data){
  var gd = state.gridDec;
  var geod = state.geoDec;

  // Accuracy
  if(data.accuracy){
    accuracyInfo.style.display = "";
    accH.textContent = "\u00b1" + (data.accuracy.horizontal_accuracy_meters || "2.5") + "m horizontal (" + (data.accuracy.method || "Molodensky 3-param") + ")";
    accG.textContent = (data.accuracy.grid_accuracy || "\u00b10.001m grid conversion (exact)");
  }

  // GNG
  gngCard.style.display = "";
  gngE.textContent = fmt(data.gng.easting, gd);
  gngN.textContent = fmt(data.gng.northing, gd);

  // GMG
  gmgCard.style.display = "";
  gmgE.textContent = fmt(data.gmg.easting, gd);
  gmgN.textContent = fmt(data.gmg.northing, gd);

  // WGS84
  wgs84Card.style.display = "";
  wgsLat.textContent = fmt(data.wgs84.lat, geod);
  wgsLon.textContent = fmt(data.wgs84.lon, geod);

  // DMS
  if(state.format === "dms"){
    wgsDmsRow.style.display = "";
    wgsDms.textContent = toDms(data.wgs84.lat, "N", "S") + "  " + toDms(data.wgs84.lon, "E", "W");
  } else {
    wgsDmsRow.style.display = "none";
  }
}

/* ═══════════════════════════════════════════════════════════════════════
   FEATURE 1: ELEVATION
   ═══════════════════════════════════════════════════════════════════════ */
async function fetchElevation(lat, lon){
  elevLine.style.display = "";
  elevLine.classList.add("loading");
  elevValue.innerHTML = '<span class="spinner"></span>Fetching\u2026';
  var key = lat.toFixed(4) + "," + lon.toFixed(4);
  if(state.elevCache[key]){
    showElevation(state.elevCache[key]);
    return;
  }
  try {
    var res = await fetch("/api/elevation?lat=" + encodeURIComponent(lat) + "&lon=" + encodeURIComponent(lon));
    var data = await res.json();
    if(data.elevation != null){
      state.elevCache[key] = data;
      showElevation(data);
    } else {
      elevValue.textContent = "N/A";
    }
  } catch(e){
    elevValue.textContent = "Error";
  }
}

function showElevation(data){
  elevLine.classList.remove("loading");
  elevValue.textContent = data.elevation.toFixed(1) + "m (" + (data.source || "SRTM") + ")";
}

/* ═══════════════════════════════════════════════════════════════════════
   FEATURE 2: REVERSE GEOCODE
   ═══════════════════════════════════════════════════════════════════════ */
async function fetchGeocode(lat, lon){
  geocodeLine.style.display = "";
  geocodeLine.classList.add("loading");
  geocodeValue.innerHTML = '<span class="spinner"></span>Looking up\u2026';
  var key = lat.toFixed(4) + "," + lon.toFixed(4);
  if(state.geocodeCache[key]){
    showGeocode(state.geocodeCache[key]);
    return;
  }
  try {
    var res = await fetch("/api/geocode?lat=" + encodeURIComponent(lat) + "&lon=" + encodeURIComponent(lon));
    var data = await res.json();
    state.geocodeCache[key] = data;
    showGeocode(data);
  } catch(e){
    geocodeValue.textContent = "Error";
  }
}

function showGeocode(data){
  geocodeLine.classList.remove("loading");
  if(data.region || data.district){
    var parts = [];
    if(data.region) parts.push(data.region);
    if(data.district) parts.push(data.district);
    geocodeValue.textContent = parts.join(", ");
  } else if(data.display_name){
    geocodeValue.textContent = data.display_name.split(",").slice(0,3).join(",").trim();
  } else {
    geocodeValue.textContent = "N/A";
  }
}

/* ═══════════════════════════════════════════════════════════════════════
   FEATURE 4: CSV IMPORT
   ═══════════════════════════════════════════════════════════════════════ */
$("#importCsvBtn").addEventListener("click", function(){ csvFileInput.click(); });
csvFileInput.addEventListener("change", function(e){
  var file = e.target.files[0];
  if(!file) return;
  var reader = new FileReader();
  reader.onload = function(ev){
    try {
      var text = ev.target.result;
      parseAndConvertCsv(text, file.name);
    } catch(err){
      toast("CSV parse error: " + err.message, true);
    }
  };
  reader.readAsText(file);
  csvFileInput.value = "";
});

function parseAndConvertCsv(text, filename){
  var lines = text.trim().split(/\r?\n/);
  if(lines.length < 2){ toast("CSV must have a header row and at least one data row", true); return; }

  var header = lines[0].toLowerCase().split(",").map(function(h){ return h.trim().replace(/['"]/g, ""); });

  // Auto-detect columns
  var latIdx = -1, lonIdx = -1, eIdx = -1, nIdx = -1;
  header.forEach(function(h, i){
    if(/^(lat|latitude|y)$/i.test(h)) latIdx = i;
    else if(/^(lon|lng|longitude|x)$/i.test(h)) lonIdx = i;
    else if(/^(easting|e|east)$/i.test(h)) eIdx = i;
    else if(/^(northing|n|north)$/i.test(h)) nIdx = i;
  });

  var hasGeo = latIdx >= 0 && lonIdx >= 0;
  var hasGrid = eIdx >= 0 && nIdx >= 0;
  if(!hasGeo && !hasGrid){ toast("Could not detect lat/lon or easting/northing columns", true); return; }

  var points = [];
  for(var i = 1; i < lines.length; i++){
    var cols = lines[i].split(",").map(function(c){ return c.trim().replace(/['"]/g, ""); });
    if(cols.length < 2) continue;
    if(hasGeo){
      var lat = parseLatLon(cols[latIdx]);
      var lon = parseLatLon(cols[lonIdx]);
      if(!isNaN(lat) && !isNaN(lon)) points.push({ mode: "WGS84_TO_GRID", lat: lat, lon: lon });
    } else {
      var easting = parseFloat(cols[eIdx]);
      var northing = parseFloat(cols[nIdx]);
      if(!isNaN(easting) && !isNaN(northing)){
        var mode = state.tab === "grid_to_wgs84" ? "GRID_TO_WGS84" : "GNG_GMG";
        points.push({ mode: mode, easting: easting, northing: northing, from_crs: state.gridCrs });
      }
    }
  }

  if(points.length === 0){ toast("No valid rows found in CSV", true); return; }

  convertBatch(points, filename);
}

async function convertBatch(points, filename){
  convertBtn.disabled = true;
  convertBtn.textContent = "Converting batch\u2026";
  try {
    var res = await fetch("/api/convert_batch", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ points: points })
    });
    var data = await res.json();
    var results = data.results || [];
    state.batchResults = results;

    // Show batch table
    batchTableBody.innerHTML = "";
    var gd = state.gridDec, geod = state.geoDec;
    results.forEach(function(r, idx){
      var tr = document.createElement("tr");
      tr.innerHTML = "<td>" + (idx+1) + "</td>"
        + "<td>" + fmt(r.gng.easting, gd) + "</td>"
        + "<td>" + fmt(r.gng.northing, gd) + "</td>"
        + "<td>" + fmt(r.gmg.easting, gd) + "</td>"
        + "<td>" + fmt(r.gmg.northing, gd) + "</td>"
        + "<td>" + fmt(r.wgs84.lat, geod) + "</td>"
        + "<td>" + fmt(r.wgs84.lon, geod) + "</td>";
      batchTableBody.appendChild(tr);
    });
    batchTableWrap.classList.add("show");

    if(filename){
      importInfo.style.display = "flex";
      importInfo.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>'
        + filename + " &mdash; " + results.length + " rows";
    }

    // Show first result in main output
    if(results.length > 0){
      state.lastResult = results[0];
      displayResult(results[0]);
      fetchElevation(results[0].wgs84.lat, results[0].wgs84.lon);
      fetchGeocode(results[0].wgs84.lat, results[0].wgs84.lon);
    }

    if(data.errors && data.errors.length > 0){
      toast(data.errors.length + " row(s) had errors", true);
    } else {
      toast("Batch: " + results.length + " point(s) converted");
    }
  } catch(err){
    toast("Batch error: " + err.message, true);
  } finally {
    convertBtn.disabled = false;
    convertBtn.textContent = "Convert";
  }
}

/* ═══════════════════════════════════════════════════════════════════════
   FEATURE 5: SESSION HISTORY
   ═══════════════════════════════════════════════════════════════════════ */
$("#historyBtn").addEventListener("click", function(e){
  e.stopPropagation();
  closeAllDropdowns();
  renderHistory();
  $("#historyDropdown").classList.add("open");
});

$("#clearHistoryBtn").addEventListener("click", function(e){
  e.stopPropagation();
  saveHistory([]);
  renderHistory();
  toast("History cleared");
});

function addToHistory(input, result){
  var entry = {
    ts: new Date().toISOString(),
    input: input,
    result: {
      gng: result.gng,
      gmg: result.gmg,
      wgs84: result.wgs84
    }
  };
  var h = getHistory();
  h.unshift(entry);
  if(h.length > 30) h = h.slice(0, 30);
  saveHistory(h);
}

function renderHistory(){
  var h = getHistory();
  if(h.length === 0){
    historyList.innerHTML = '<div class="dropdown-empty">No history yet</div>';
    return;
  }
  historyList.innerHTML = "";
  h.forEach(function(entry, idx){
    var div = document.createElement("div");
    div.className = "dropdown-item";
    var d = new Date(entry.ts);
    var time = d.toLocaleTimeString([], {hour:"2-digit",minute:"2-digit"}) + " " + d.toLocaleDateString();
    var coords = entry.result.wgs84.lat.toFixed(5) + ", " + entry.result.wgs84.lon.toFixed(5);
    div.innerHTML = '<div class="di-time">' + time + '</div>'
      + '<div class="di-coords">' + coords + '</div>';
    div.addEventListener("click", function(){
      loadFromHistory(entry);
      closeAllDropdowns();
    });
    historyList.appendChild(div);
  });
}

function loadFromHistory(entry){
  var inp = entry.input;
  if(inp.mode === "WGS84_TO_GRID"){
    switchTab("wgs84_to_grid");
    inputLat.value = inp.lat;
    inputLon.value = inp.lon;
  } else {
    var tab = inp.mode === "GNG_GMG" ? "gng_gmg" : "grid_to_wgs84";
    switchTab(tab);
    state.gridCrs = inp.from_crs || "GNG";
    updateGridCrsButtons();
    inputEasting.value = inp.easting;
    inputNorthing.value = inp.northing;
  }
  state.lastResult = entry.result;
  displayResult(entry.result);
  fetchElevation(entry.result.wgs84.lat, entry.result.wgs84.lon);
  fetchGeocode(entry.result.wgs84.lat, entry.result.wgs84.lon);
  prefillAzPointA(entry.result.wgs84.lat, entry.result.wgs84.lon);
  toast("Loaded from history");
}

function switchTab(tabName){
  state.tab = tabName;
  $$(".tab-btn").forEach(function(b){
    b.classList.toggle("active", b.dataset.tab === tabName);
  });
  updateInputVisibility();
}

function updateGridCrsButtons(){
  $$(".grid-type-btn").forEach(function(b){
    b.classList.toggle("active", b.dataset.crs === state.gridCrs);
  });
}

/* ═══════════════════════════════════════════════════════════════════════
   FEATURE 6: BOOKMARKS
   ═══════════════════════════════════════════════════════════════════════ */
$("#bookmarksBtn").addEventListener("click", function(e){
  e.stopPropagation();
  closeAllDropdowns();
  renderBookmarks();
  $("#bookmarksDropdown").classList.add("open");
});

function renderBookmarks(){
  var b = getBookmarks();
  if(b.length === 0){
    bookmarksList.innerHTML = '<div class="dropdown-empty">No bookmarks yet</div>';
    return;
  }
  bookmarksList.innerHTML = "";
  b.forEach(function(bm, idx){
    var div = document.createElement("div");
    div.className = "dropdown-item";
    var coords = bm.wgs84.lat.toFixed(6) + ", " + bm.wgs84.lon.toFixed(6);
    div.innerHTML = '<div class="di-name"><span>' + escapeHtml(bm.name) + '</span>'
      + '<button class="di-delete" data-idx="' + idx + '" title="Delete">&times;</button></div>'
      + '<div class="di-coords">' + coords + '</div>';
    div.querySelector(".di-delete").addEventListener("click", function(e){
      e.stopPropagation();
      var bookmarks = getBookmarks();
      bookmarks.splice(idx, 1);
      saveBookmarks(bookmarks);
      renderBookmarks();
      toast("Bookmark removed");
    });
    div.addEventListener("click", function(e){
      if(e.target.classList.contains("di-delete")) return;
      loadBookmark(bm);
      closeAllDropdowns();
    });
    bookmarksList.appendChild(div);
  });
}

function loadBookmark(bm){
  switchTab("wgs84_to_grid");
  inputLat.value = bm.wgs84.lat;
  inputLon.value = bm.wgs84.lon;
  state.lastResult = { gng: bm.gng, gmg: bm.gmg, wgs84: bm.wgs84, accuracy: ACCURACY_FALLBACK };
  displayResult(state.lastResult);
  fetchElevation(bm.wgs84.lat, bm.wgs84.lon);
  fetchGeocode(bm.wgs84.lat, bm.wgs84.lon);
  prefillAzPointA(bm.wgs84.lat, bm.wgs84.lon);
  toast("Loaded: " + bm.name);
}

var ACCURACY_FALLBACK = {
  horizontal_accuracy_meters: "\u00b12.5",
  method: "Molodensky 3-param",
  grid_accuracy: "\u00b10.001m (exact arithmetic conversion)"
};

// Bookmark button in GNG card
$("#bookmarkGng").addEventListener("click", function(){
  if(!state.lastResult) { toast("Convert a point first", true); return; }
  var name = prompt("Bookmark name:");
  if(name === null) return;
  name = name.trim();
  if(!name) { toast("Name required", true); return; }
  var bm = {
    name: name,
    gng: state.lastResult.gng,
    gmg: state.lastResult.gmg,
    wgs84: state.lastResult.wgs84
  };
  var bookmarks = getBookmarks();
  bookmarks.unshift(bm);
  saveBookmarks(bookmarks);
  toast("Bookmarked: " + name);
});

function escapeHtml(str){
  var div = document.createElement("div");
  div.textContent = str;
  return div.innerHTML;
}

/* ═══════════════════════════════════════════════════════════════════════
   FEATURE 7: KML / GeoJSON EXPORT
   ═══════════════════════════════════════════════════════════════════════ */
$("#exportKmlBtn").addEventListener("click", function(){
  if(state.batchResults.length === 0){ toast("Nothing to export", true); return; }
  var gd = state.gridDec, geod = state.geoDec;
  var placemarks = "";
  state.batchResults.forEach(function(r, i){
    placemarks += '    <Placemark>\n'
      + '      <name>Point ' + (i+1) + '</name>\n'
      + '      <description><![CDATA[GNG: ' + r.gng.easting + ', ' + r.gng.northing + '\\nGMG: ' + r.gmg.easting + ', ' + r.gmg.northing + ']]></description>\n'
      + '      <Point><coordinates>' + r.wgs84.lon + ',' + r.wgs84.lat + ',0</coordinates></Point>\n'
      + '    </Placemark>\n';
  });
  var kml = '<?xml version="1.0" encoding="UTF-8"?>\n'
    + '<kml xmlns="http://www.opengis.net/kml/2.2">\n'
    + '  <Document>\n'
    + '    <name>Ghana Geodetic Export</name>\n'
    + placemarks
    + '  </Document>\n'
    + '</kml>';
  downloadFile("ghana_geodetic_export.kml", kml, "application/vnd.google-earth.kml+xml");
  toast("KML exported");
});

$("#exportGeoJsonBtn").addEventListener("click", function(){
  if(state.batchResults.length === 0){ toast("Nothing to export", true); return; }
  var features = state.batchResults.map(function(r, i){
    return {
      type: "Feature",
      properties: {
        id: i + 1,
        gng_e: r.gng.easting,
        gng_n: r.gng.northing,
        gmg_e: r.gmg.easting,
        gmg_n: r.gmg.northing
      },
      geometry: {
        type: "Point",
        coordinates: [r.wgs84.lon, r.wgs84.lat]
      }
    };
  });
  var geojson = { type: "FeatureCollection", features: features };
  downloadFile("ghana_geodetic_export.geojson", JSON.stringify(geojson, null, 2), "application/geo+json");
  toast("GeoJSON exported");
});

/* ═══════════════════════════════════════════════════════════════════════
   CSV EXPORT
   ═══════════════════════════════════════════════════════════════════════ */
$("#exportCsvBtn").addEventListener("click", function(){
  if(state.batchResults.length === 0){ toast("Nothing to export", true); return; }
  var gd = state.gridDec, geod = state.geoDec;
  var csv = "gng_easting,gng_northing,gmg_easting,gmg_northing,wgs84_lat,wgs84_lon\n";
  state.batchResults.forEach(function(r){
    csv += r.gng.easting.toFixed(gd) + "," + r.gng.northing.toFixed(gd) + ","
      + r.gmg.easting.toFixed(gd) + "," + r.gmg.northing.toFixed(gd) + ","
      + r.wgs84.lat.toFixed(geod) + "," + r.wgs84.lon.toFixed(geod) + "\n";
  });
  downloadFile("ghana_geodetic_export.csv", csv, "text/csv");
  toast("CSV exported");
});

/* ═══════════════════════════════════════════════════════════════════════
   FEATURE 9: AZIMUTH & DISTANCE
   ═══════════════════════════════════════════════════════════════════════ */
$("#azimuthToggle").addEventListener("click", function(){
  var body = $("#azimuthBody");
  var isOpen = body.classList.toggle("open");
  this.classList.toggle("open", isOpen);
});

function prefillAzPointA(lat, lon){
  azLat1.value = lat;
  azLon1.value = lon;
}

$("#azCalcBtn").addEventListener("click", async function(){
  var lat1 = parseFloat(azLat1.value);
  var lon1 = parseFloat(azLon1.value);
  var lat2 = parseFloat(azLat2.value);
  var lon2 = parseFloat(azLon2.value);
  if([lat1,lon1,lat2,lon2].some(isNaN)){
    toast("Enter all four coordinates for azimuth calculation", true);
    return;
  }
  this.disabled = true;
  this.textContent = "Calculating\u2026";
  try {
    var res = await fetch("/api/azimuth_distance", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ lat1: lat1, lon1: lon1, lat2: lat2, lon2: lon2 })
    });
    var data = await res.json();
    if(!res.ok){ toast(data.error || "Azimuth calculation failed", true); return; }
    $("#azResults").classList.add("show");
    $("#azDist").textContent = data.distance_m.toLocaleString(undefined, {maximumFractionDigits:2}) + " m";
    $("#azDistFt").textContent = data.distance_ft.toLocaleString(undefined, {maximumFractionDigits:2}) + " ft";
    $("#azBear1").textContent = data.initial_bearing_deg.toFixed(4) + "\u00b0";
    $("#azBear2").textContent = data.final_bearing_deg.toFixed(4) + "\u00b0";
    toast("Azimuth calculated");
  } catch(e){
    toast("Network error: " + e.message, true);
  } finally {
    this.disabled = false;
    this.textContent = "Calculate";
  }
});

/* ═══════════════════════════════════════════════════════════════════════
   CLICK-TO-COPY
   ═══════════════════════════════════════════════════════════════════════ */
document.addEventListener("click", function(e){
  var row = e.target.closest("[data-copy]");
  if(!row) return;
  var key = row.dataset.copy;
  var text = "";
  switch(key){
    case "gng": text = state.lastResult ? state.lastResult.gng.easting + ", " + state.lastResult.gng.northing : ""; break;
    case "gngE": text = state.lastResult ? String(state.lastResult.gng.easting) : ""; break;
    case "gngN": text = state.lastResult ? String(state.lastResult.gng.northing) : ""; break;
    case "gmg": text = state.lastResult ? state.lastResult.gmg.easting + ", " + state.lastResult.gmg.northing : ""; break;
    case "gmgE": text = state.lastResult ? String(state.lastResult.gmg.easting) : ""; break;
    case "gmgN": text = state.lastResult ? String(state.lastResult.gmg.northing) : ""; break;
    case "wgs84": text = state.lastResult ? state.lastResult.wgs84.lat + ", " + state.lastResult.wgs84.lon : ""; break;
    case "wgsLat": text = state.lastResult ? String(state.lastResult.wgs84.lat) : ""; break;
    case "wgsLon": text = state.lastResult ? String(state.lastResult.wgs84.lon) : ""; break;
    case "wgsDms":
      if(state.lastResult){
        text = toDms(state.lastResult.wgs84.lat, "N", "S") + " " + toDms(state.lastResult.wgs84.lon, "E", "W");
      }
      break;
  }
  if(!text) return;
  navigator.clipboard.writeText(text).then(function(){
    toast("Copied: " + text);
    // Brief visual feedback
    var btn = row.closest(".result-card") ? row.closest(".result-card").querySelector(".copy-btn") : null;
    if(btn){
      btn.classList.add("copied");
      setTimeout(function(){ btn.classList.remove("copied"); }, 800);
    }
  });
});

/* ═══════════════════════════════════════════════════════════════════════
   CLEAR
   ═══════════════════════════════════════════════════════════════════════ */
$("#clearBtn").addEventListener("click", doClear);

function doClear(){
  inputLat.value = ""; inputLon.value = "";
  inputEasting.value = ""; inputNorthing.value = "";
  errorMsg.classList.remove("show");
  clearErrorStyles();
  gngCard.style.display = "none"; gmgCard.style.display = "none"; wgs84Card.style.display = "none";
  accuracyInfo.style.display = "none";
  elevLine.style.display = "none"; geocodeLine.style.display = "none";
  batchTableWrap.classList.remove("show"); importInfo.style.display = "none";
  $("#azResults").classList.remove("show");
  state.lastResult = null; state.batchResults = [];
  dmsLatDeg.value = ""; dmsLatMin.value = ""; dmsLatSec.value = "";
  dmsLonDeg.value = ""; dmsLonMin.value = ""; dmsLonSec.value = "";
  toast("Cleared");
}

/* ═══════════════════════════════════════════════════════════════════════
   KEYBOARD SHORTCUTS
   ═══════════════════════════════════════════════════════════════════════ */
document.addEventListener("keydown", function(e){
  // Ctrl+Enter = copy last result as text
  if((e.ctrlKey || e.metaKey) && e.key === "Enter"){
    e.preventDefault();
    if(state.lastResult){
      var text = state.lastResult.wgs84.lat + ", " + state.lastResult.wgs84.lon;
      navigator.clipboard.writeText(text).then(function(){ toast("Copied: " + text); });
    }
  }
  // Esc = clear
  if(e.key === "Escape" && !e.ctrlKey && !e.metaKey){
    closeAllDropdowns();
    doClear();
  }
});

/* ═══════════════════════════════════════════════════════════════════════
   DROPDOWN MANAGEMENT
   ═══════════════════════════════════════════════════════════════════════ */
function closeAllDropdowns(){
  $$(".dropdown-menu").forEach(function(m){ m.classList.remove("open"); });
}
document.addEventListener("click", function(e){
  if(!e.target.closest(".dropdown-wrap")){
    closeAllDropdowns();
  }
});

/* ═══════════════════════════════════════════════════════════════════════
   INIT
   ═══════════════════════════════════════════════════════════════════════ */
updateInputVisibility();

// PWA Service Worker Registration
if('serviceWorker' in navigator){
  navigator.serviceWorker.register('/sw.js').catch(function(){});
}

})();
</script>
</body>
</html>
