<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#0F1117" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#F9FAFB" media="(prefers-color-scheme: light)">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="description" content="Ghana Geodetic Transformation Tool — WGS84, GNG, GMG">
<title>Geodetic Knife</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="manifest" href="/manifest.json">
<style>
/* ═══════════════════════════════════════════════
   RESET & BASE
   ═══════════════════════════════════════════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --s0:#0F1117;--s1:#1A1D27;--s2:#252830;--s3:#32353E;--s4:#3F4350;
  --accent:#3B82F6;--accent-h:#2563EB;--accent-glow:rgba(59,130,246,.15);
  --ok:#10B981;--ok-bg:rgba(16,185,129,.12);
  --warn:#F59E0B;--warn-bg:rgba(245,158,11,.12);
  --err:#EF4444;--err-bg:rgba(239,68,68,.12);
  --info:#6366F1;--info-bg:rgba(99,102,241,.12);
  --t1:#F9FAFB;--t2:#9CA3AF;--t3:#6B7280;
  --mono:'JetBrains Mono',ui-monospace,SFMono-Regular,monospace;
  --sans:'Inter',system-ui,-apple-system,BlinkMacSystemFont,sans-serif;
  --radius:12px;--radius-sm:8px;--radius-lg:16px;--radius-pill:9999px;
  --nav-h:56px;--header-h:56px;
  --ease:cubic-bezier(.16,1,.3,1);--ease-spring:cubic-bezier(.34,1.56,.64,1);
}
[data-theme="light"]{
  --s0:#FFFFFF;--s1:#F9FAFB;--s2:#F3F4F6;--s3:#E5E7EB;--s4:#D1D5DB;
  --accent:#2563EB;--accent-h:#1D4ED8;--accent-glow:rgba(37,99,235,.12);
  --ok:#059669;--ok-bg:rgba(5,150,105,.1);
  --warn:#D97706;--warn-bg:rgba(217,119,6,.1);
  --err:#DC2626;--err-bg:rgba(220,38,38,.1);
  --info:#4F46E5;--info-bg:rgba(79,70,229,.1);
  --t1:#111827;--t2:#6B7280;--t3:#9CA3AF;
}
html{height:100%;-webkit-text-size-adjust:100%}
body{
  font-family:var(--sans);font-size:14px;line-height:1.5;color:var(--t1);
  background:var(--s0);min-height:100dvh;
  display:flex;flex-direction:column;
  -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;
  transition:background-color .3s ease,color .3s ease;
}
button{font-family:var(--sans);cursor:pointer;border:none;background:none;color:inherit;font-size:inherit}
input,select,textarea{font-family:var(--sans);font-size:14px}
a{color:var(--accent);text-decoration:none}

/* ═══════════════════════════════════════════════
   ANTI-FOUC
   ═══════════════════════════════════════════════ */
body.themed body,body.themed header,body.themed .card,
body.themed button,body.themed input,body.themed select,body.themed textarea,
body.themed table,body.themed th,body.themed td,
body.themed .nav-item,body.themed .result-val,
body.themed .status-pill,body.themed .chip{
  transition:background-color .3s ease,color .3s ease,border-color .3s ease,box-shadow .3s ease;
}

/* ═══════════════════════════════════════════════
   HEADER
   ═══════════════════════════════════════════════ */
header{
  height:var(--header-h);display:flex;align-items:center;justify-content:space-between;
  padding:0 16px;background:var(--s1);border-bottom:1px solid var(--s2);
  position:sticky;top:0;z-index:40;flex-shrink:0;
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
}
.logo{display:flex;align-items:center;gap:10px}
.logo-icon{
  width:32px;height:32px;border-radius:var(--radius-sm);
  background:linear-gradient(135deg,var(--accent),var(--ok));
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-weight:700;font-size:14px;
}
.logo-text{font-weight:700;font-size:16px;letter-spacing:-.3px}
.logo-sub{font-size:11px;color:var(--t3);font-weight:500;margin-top:-2px}
.header-actions{display:flex;align-items:center;gap:8px}
.icon-btn{
  width:36px;height:36px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;
  background:var(--s2);color:var(--t2);transition:all .15s ease;
}
.icon-btn:hover{background:var(--s3);color:var(--t1)}
.icon-btn svg{width:18px;height:18px}

/* ═══════════════════════════════════════════════
   MAIN CONTENT
   ═══════════════════════════════════════════════ */
main{
  flex:1;overflow-y:auto;overflow-x:hidden;
  -webkit-overflow-scrolling:touch;
  padding:0 16px calc(var(--nav-h) + env(safe-area-inset-bottom) + 16px);
}
.page{display:none;padding-top:16px;padding-bottom:16px;animation:fadeUp .3s var(--ease)}
.page.active{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@keyframes shake{0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-4px)}40%,80%{transform:translateX(4px)}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
@keyframes spin{to{transform:rotate(360deg)}}

/* ═══════════════════════════════════════════════
   CARDS
   ═══════════════════════════════════════════════ */
.card{
  background:var(--s1);border:1px solid var(--s2);border-radius:var(--radius);
  padding:16px;margin-bottom:12px;
}
.card-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.card-title{font-size:13px;font-weight:600;color:var(--t2);text-transform:uppercase;letter-spacing:.5px}
.card-badge{
  font-size:11px;font-weight:600;padding:2px 8px;border-radius:var(--radius-pill);
  display:inline-flex;align-items:center;gap:4px;
}
.badge-ok{background:var(--ok-bg);color:var(--ok)}
.badge-warn{background:var(--warn-bg);color:var(--warn)}
.badge-err{background:var(--err-bg);color:var(--err)}
.badge-info{background:var(--info-bg);color:var(--info)}

/* ═══════════════════════════════════════════════
   FORM ELEMENTS
   ═══════════════════════════════════════════════ */
.field{margin-bottom:12px}
.field:last-child{margin-bottom:0}
.field-label{display:block;font-size:12px;font-weight:500;color:var(--t2);margin-bottom:6px}
.field-row{display:flex;gap:10px}
.field-row .field{flex:1}
.input-wrap{position:relative;display:flex;align-items:center}
.input-icon{
  position:absolute;left:12px;color:var(--t3);display:flex;align-items:center;
  pointer-events:none;transition:color .15s;
}
.input-icon svg{width:16px;height:16px}
.input-wrap input,.input-wrap select{
  width:100%;height:48px;padding:0 12px 0 38px;
  background:var(--s2);border:1.5px solid transparent;border-radius:var(--radius-sm);
  color:var(--t1);font-size:15px;outline:none;
  transition:border-color .2s,box-shadow .2s,background .2s;
}
.input-wrap input:focus,.input-wrap select:focus{
  border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-glow);background:var(--s0);
}
.input-wrap input:focus+.input-icon,.input-wrap select:focus~.input-icon{color:var(--accent)}
.input-wrap input::placeholder{color:var(--t3)}
.input-wrap select{appearance:none;cursor:pointer;padding-right:32px}
.input-wrap .chevron{position:absolute;right:10px;color:var(--t3);pointer-events:none}
.input-wrap .chevron svg{width:16px;height:16px}
.input-mono{font-family:var(--mono)!important;font-size:14px!important;letter-spacing:.3px}
.input-suffix{
  position:absolute;right:12px;font-size:12px;font-weight:500;color:var(--t3);
  pointer-events:none;
}
.input-wrap.has-suffix input{padding-right:44px}
input.valid{border-color:var(--ok)!important}
input.invalid{border-color:var(--err)!important;animation:shake .4s ease-in-out}
input.valid:focus{box-shadow:0 0 0 3px var(--ok-bg)!important}
input.invalid:focus{box-shadow:0 0 0 3px var(--err-bg)!important}

/* ═══════════════════════════════════════════════
   BUTTONS
   ═══════════════════════════════════════════════ */
.btn{
  height:48px;border-radius:var(--radius-sm);font-weight:600;font-size:14px;
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:0 20px;transition:all .15s ease;user-select:none;
}
.btn:active{transform:scale(.97)}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:var(--accent-h)}
.btn-full{width:100%}
.btn-sm{height:36px;font-size:12px;padding:0 12px;border-radius:var(--radius-sm)}
.btn-ghost{background:transparent;color:var(--t2)}
.btn-ghost:hover{background:var(--s2);color:var(--t1)}
.btn-outline{border:1.5px solid var(--s3);color:var(--t1)}
.btn-outline:hover{border-color:var(--accent);color:var(--accent)}
.btn-danger{background:var(--err);color:#fff}
.btn-danger:hover{opacity:.9}
.btn svg{width:18px;height:18px}

/* ═══════════════════════════════════════════════
   CHIPS
   ═══════════════════════════════════════════════ */
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{
  height:32px;padding:0 12px;border-radius:var(--radius-pill);font-size:12px;font-weight:500;
  display:inline-flex;align-items:center;gap:4px;
  background:var(--s2);color:var(--t2);border:1.5px solid transparent;
  transition:all .15s;cursor:pointer;
}
.chip:hover{border-color:var(--s3)}
.chip.active{background:var(--accent-glow);color:var(--accent);border-color:var(--accent)}
.chip svg{width:14px;height:14px}

/* ═══════════════════════════════════════════════
   SWAP BUTTON
   ═══════════════════════════════════════════════ */
.swap-wrap{display:flex;justify-content:center;margin:4px 0}
.swap-btn{
  width:40px;height:40px;border-radius:50%;background:var(--s2);color:var(--t2);
  display:flex;align-items:center;justify-content:center;
  border:1.5px solid var(--s3);transition:all .25s var(--ease-spring);
}
.swap-btn:hover{background:var(--accent-glow);color:var(--accent);border-color:var(--accent)}
.swap-btn.rotated svg{transform:rotate(180deg)}
.swap-btn svg{width:18px;height:18px;transition:transform .4s var(--ease-spring)}

/* ═══════════════════════════════════════════════
   RESULT DISPLAY
   ═══════════════════════════════════════════════ */
.result-card{border-color:var(--ok);border-width:1.5px}
.result-row{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 0;border-bottom:1px solid var(--s2);
}
.result-row:last-child{border-bottom:none;padding-bottom:0}
.result-label{font-size:12px;font-weight:500;color:var(--t2);min-width:60px}
.result-val{
  font-family:var(--mono);font-size:14px;font-weight:500;color:var(--t1);
  display:flex;align-items:center;gap:8px;word-break:break-all;
}
.result-unit{font-family:var(--sans);font-size:11px;font-weight:500;color:var(--t3);min-width:24px;text-align:right}
.copy-btn{
  width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;
  color:var(--t3);transition:all .15s;flex-shrink:0;
}
.copy-btn:hover{background:var(--s2);color:var(--accent)}
.copy-btn svg{width:14px;height:14px}
.copy-btn.copied{color:var(--ok)}

/* ── KPI Cards ── */
.kpi-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.kpi{
  background:var(--s2);border-radius:var(--radius-sm);padding:12px;text-align:center;
}
.kpi-label{font-size:11px;font-weight:500;color:var(--t3);margin-bottom:4px}
.kpi-val{font-family:var(--mono);font-size:18px;font-weight:600;color:var(--t1)}
.kpi-unit{font-family:var(--sans);font-size:10px;color:var(--t3);margin-left:2px}

/* ── Location pill ── */
.location-pill{
  display:flex;align-items:center;gap:6px;padding:8px 12px;
  background:var(--s2);border-radius:var(--radius-sm);font-size:12px;color:var(--t2);
  margin-top:8px;
}
.location-pill svg{width:14px;height:14px;flex-shrink:0;color:var(--t3)}

/* ═══════════════════════════════════════════════
   BOTTOM NAVIGATION
   ═══════════════════════════════════════════════ */
.bottom-nav{
  position:fixed;bottom:0;left:0;right:0;height:calc(var(--nav-h) + env(safe-area-inset-bottom));
  background:var(--s1);border-top:1px solid var(--s2);
  display:flex;align-items:flex-start;justify-content:space-around;
  padding-top:6px;padding-bottom:env(safe-area-inset-bottom);
  z-index:50;
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
}
.nav-item{
  display:flex;flex-direction:column;align-items:center;gap:2px;
  padding:4px 12px;min-width:56px;border-radius:var(--radius-sm);
  color:var(--t3);transition:color .2s;font-size:10px;font-weight:500;
  position:relative;
}
.nav-item svg{width:22px;height:22px;transition:all .2s}
.nav-item.active{color:var(--accent)}
.nav-item.active::before{
  content:'';position:absolute;top:-7px;left:50%;transform:translateX(-50%);
  width:20px;height:2px;border-radius:1px;background:var(--accent);
}
.nav-item:active{transform:scale(.92)}

/* ═══════════════════════════════════════════════
   STATUS PILL
   ═══════════════════════════════════════════════ */
.status-pill{
  font-size:11px;font-weight:600;padding:3px 10px;border-radius:var(--radius-pill);
  display:inline-flex;align-items:center;gap:5px;
}
.status-dot{width:6px;height:6px;border-radius:50%}
.status-online{background:var(--ok-bg);color:var(--ok)}
.status-online .status-dot{background:var(--ok)}
.status-offline{background:var(--warn-bg);color:var(--warn)}
.status-offline .status-dot{background:var(--warn);animation:pulse 1.5s infinite}

/* ═══════════════════════════════════════════════
   GPS BUTTON
   ═══════════════════════════════════════════════ */
.gps-btn{
  height:36px;padding:0 12px;border-radius:var(--radius-sm);font-size:12px;font-weight:500;
  display:inline-flex;align-items:center;gap:5px;
  background:var(--s2);color:var(--accent);border:1px solid var(--s3);
  transition:all .15s;
}
.gps-btn:hover{border-color:var(--accent);background:var(--accent-glow)}
.gps-btn:active{transform:scale(.97)}
.gps-btn svg{width:14px;height:14px}
.gps-btn.loading svg{animation:spin 1s linear infinite}

/* ═══════════════════════════════════════════════
   SETTINGS PAGE
   ═══════════════════════════════════════════════ */
.setting-item{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 0;border-bottom:1px solid var(--s2);
}
.setting-item:last-child{border-bottom:none}
.setting-label{font-size:14px;font-weight:500;color:var(--t1)}
.setting-desc{font-size:12px;color:var(--t3);margin-top:2px}
.setting-action{display:flex;align-items:center;gap:8px}
.toggle{
  width:44px;height:24px;border-radius:12px;background:var(--s3);position:relative;
  transition:background .2s;cursor:pointer;flex-shrink:0;
}
.toggle.on{background:var(--accent)}
.toggle::after{
  content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;
  border-radius:50%;background:#fff;transition:transform .2s var(--ease-spring);
}
.toggle.on::after{transform:translateX(20px)}
.seg-control{display:flex;background:var(--s2);border-radius:var(--radius-sm);padding:2px;gap:2px}
.seg-btn{
  height:32px;padding:0 14px;border-radius:6px;font-size:12px;font-weight:500;
  display:flex;align-items:center;justify-content:center;
  color:var(--t3);transition:all .2s;flex:1;
}
.seg-btn.active{background:var(--accent);color:#fff}

/* ═══════════════════════════════════════════════
   CALIBRATION PAGE
   ═══════════════════════════════════════════════ */
.cp-table{width:100%;border-collapse:collapse;font-size:13px}
.cp-table th{
  text-align:left;font-size:11px;font-weight:600;color:var(--t3);
  text-transform:uppercase;letter-spacing:.5px;padding:8px 6px;
  border-bottom:1px solid var(--s2);
}
.cp-table td{padding:8px 6px;border-bottom:1px solid var(--s2);vertical-align:middle}
.cp-table input{
  width:100%;height:36px;padding:0 8px;
  background:var(--s2);border:1.5px solid transparent;border-radius:6px;
  color:var(--t1);font-family:var(--mono);font-size:12px;outline:none;
  transition:border-color .2s;
}
.cp-table input:focus{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-glow)}
.cp-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.param-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:8px}
.param-item{
  background:var(--s2);border-radius:var(--radius-sm);padding:8px;text-align:center;
}
.param-item .p-label{font-size:10px;color:var(--t3);font-weight:500;margin-bottom:2px}
.param-item .p-val{font-family:var(--mono);font-size:12px;font-weight:600;color:var(--t1)}
.residual-good{color:var(--ok)}
.residual-warn{color:var(--warn)}
.residual-bad{color:var(--err)}

/* ═══════════════════════════════════════════════
   BATCH PAGE
   ═══════════════════════════════════════════════ */
.batch-textarea{
  width:100%;min-height:160px;padding:12px;
  background:var(--s2);border:1.5px solid transparent;border-radius:var(--radius-sm);
  color:var(--t1);font-family:var(--mono);font-size:12px;line-height:1.6;
  outline:none;resize:vertical;transition:border-color .2s;
}
.batch-textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-glow)}
.batch-textarea::placeholder{color:var(--t3)}
.batch-results{margin-top:12px;max-height:400px;overflow-y:auto}
.batch-row{
  display:flex;align-items:center;gap:8px;padding:8px 10px;
  border-bottom:1px solid var(--s2);font-size:12px;
}
.batch-row:nth-child(even){background:var(--s2)}
.batch-idx{color:var(--t3);font-weight:600;min-width:24px;font-family:var(--mono)}
.batch-coord{font-family:var(--mono);color:var(--t1);flex:1;word-break:break-all}

/* ═══════════════════════════════════════════════
   TOAST
   ═══════════════════════════════════════════════ */
.toast{
  position:fixed;top:calc(var(--header-h) + 12px);left:50%;transform:translateX(-50%) translateY(-100px);
  padding:10px 20px;border-radius:var(--radius-sm);font-size:13px;font-weight:500;
  z-index:100;opacity:0;transition:all .3s var(--ease);pointer-events:none;
  box-shadow:0 4px 16px rgba(0,0,0,.2);max-width:90%;
}
.toast.show{transform:translateX(-50%) translateY(0);opacity:1}
.toast-ok{background:var(--ok);color:#fff}
.toast-err{background:var(--err);color:#fff}
.toast-info{background:var(--info);color:#fff}

/* ═══════════════════════════════════════════════
   LOADING SKELETON
   ═══════════════════════════════════════════════ */
.skeleton{
  background:var(--s2);border-radius:var(--radius-sm);position:relative;overflow:hidden;
}
.skeleton::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.04),transparent);
  animation:shimmer 1.5s infinite;
}
@keyframes shimmer{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}

/* ═══════════════════════════════════════════════
   DESKTOP (>768px)
   ═══════════════════════════════════════════════ */
@media(min-width:768px){
  .bottom-nav{
    left:auto;right:0;top:var(--header-h);bottom:0;width:220px;
    flex-direction:column;height:auto;justify-content:flex-start;padding:16px 12px;
    border-top:none;border-right:1px solid var(--s2);border-radius:0;
    gap:4px;
  }
  .nav-item{
    flex-direction:row;justify-content:flex-start;gap:12px;
    padding:10px 12px;width:100%;font-size:13px;
  }
  .nav-item.active::before{
    top:50%;left:0;transform:translateY(-50%);width:3px;height:24px;
  }
  main{
    margin-left:220px;padding:0 32px calc(env(safe-area-inset-bottom) + 32px);
    max-width:720px;
  }
  .kpi-grid{grid-template-columns:repeat(4,1fr)}
  .param-grid{grid-template-columns:repeat(7,1fr)}
}

/* ═══════════════════════════════════════════════
   SCROLLBAR
   ═══════════════════════════════════════════════ */
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--s3);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--s4)}

/* ═══════════════════════════════════════════════
   UTILITY
   ═══════════════════════════════════════════════ */
.flex{display:flex}.flex-col{flex-direction:column}.items-center{align-items:center}
.justify-between{justify-content:space-between}.gap-2{gap:8px}.gap-3{gap:12px}.gap-4{gap:16px}
.mt-2{margin-top:8px}.mt-3{margin-top:12px}.mt-4{margin-top:16px}.mb-2{margin-bottom:8px}
.text-center{text-align:center}.text-sm{font-size:12px}.text-xs{font-size:11px}
.text-muted{color:var(--t3)}.text-sec{color:var(--t2)}
.hidden{display:none!important}.w-full{width:100%}
</style>
</head>
<body class="themed">

<!-- ═══════ HEADER ═══════ -->
<header>
  <div class="logo">
    <div class="logo-icon">GK</div>
    <div>
      <div class="logo-text">Geodetic Knife</div>
      <div class="logo-sub">Ghana Transformation Tool</div>
    </div>
  </div>
  <div class="header-actions">
    <div id="statusPill" class="status-pill status-online"><span class="status-dot"></span>Online</div>
    <button class="icon-btn" onclick="toggleTheme()" title="Toggle theme">
      <svg id="themeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
  </div>
</header>

<!-- ═══════ MAIN ═══════ -->
<main>

<!-- ─── PAGE: TRANSFORM ─── -->
<div id="page-transform" class="page active">
  <!-- Source Datum -->
  <div class="card">
    <div class="card-header">
      <span class="card-title">Source Datum</span>
      <span id="methodBadge" class="card-badge badge-info">EPSG:6896</span>
    </div>
    <div class="field">
      <label class="field-label">Coordinate System</label>
      <div class="chips" id="srcCrsChips">
        <button class="chip active" data-value="WGS84" onclick="setSrcCrs(this)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10A15.3 15.3 0 0 1 12 2z"/></svg>
          WGS 84
        </button>
        <button class="chip" data-value="GNG" onclick="setSrcCrs(this)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>
          GNG
        </button>
        <button class="chip" data-value="GMG" onclick="setSrcCrs(this)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>
          GMG
        </button>
      </div>
    </div>
  </div>

  <!-- Coordinates Input -->
  <div class="card" id="coordInputCard">
    <!-- WGS84 inputs -->
    <div id="wgs84Inputs">
      <div class="card-header">
        <span class="card-title">Coordinates</span>
        <button class="gps-btn" onclick="useGPS()" id="gpsBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/></svg>
          GPS
        </button>
      </div>
      <div class="field-row">
        <div class="field">
          <label class="field-label">Latitude</label>
          <div class="input-wrap has-suffix">
            <input type="number" id="latInput" step="any" placeholder="5.5560" class="input-mono">
            <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg></span>
            <span class="input-suffix">°</span>
          </div>
        </div>
        <div class="field">
          <label class="field-label">Longitude</label>
          <div class="input-wrap has-suffix">
            <input type="number" id="lonInput" step="any" placeholder="-0.1850" class="input-mono">
            <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/></svg></span>
            <span class="input-suffix">°</span>
          </div>
        </div>
      </div>
    </div>
    <!-- Grid inputs -->
    <div id="gridInputs" class="hidden">
      <div class="card-header"><span class="card-title">Grid Coordinates</span></div>
      <div class="field-row">
        <div class="field">
          <label class="field-label">Easting</label>
          <div class="input-wrap">
            <input type="number" id="eastingInput" step="any" placeholder="274000" class="input-mono">
            <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </div>
        </div>
        <div class="field">
          <label class="field-label">Northing</label>
          <div class="input-wrap">
            <input type="number" id="northingInput" step="any" placeholder="615000" class="input-mono">
            <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Swap -->
  <div class="swap-wrap">
    <button class="swap-btn" onclick="swapDatum()" title="Swap source & target">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 16V4m0 0L3 8m4-4l4 4"/><path d="M17 8v12m0 0l4-4m-4 4l-4-4"/></svg>
    </button>
  </div>

  <!-- Target Datum -->
  <div class="card">
    <div class="card-header">
      <span class="card-title">Target</span>
      <span id="targetLabel" class="text-sm text-sec">GNG Grid</span>
    </div>
    <div class="chips" id="tgtCrsChips">
      <button class="chip active" data-value="GNG" onclick="setTgtCrs(this)">GNG</button>
      <button class="chip" data-value="GMG" onclick="setTgtCrs(this)">GMG</button>
      <button class="chip" data-value="WGS84" onclick="setTgtCrs(this)">WGS 84</button>
    </div>
  </div>

  <!-- Transform Button -->
  <button class="btn btn-primary btn-full" onclick="doTransform()" id="transformBtn">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
    Transform
  </button>

  <!-- Results (hidden until transform) -->
  <div id="resultsCard" class="card result-card hidden" style="margin-top:12px">
    <div class="card-header">
      <span class="card-title">Result</span>
      <span id="accuracyBadge" class="card-badge badge-ok">~6m</span>
    </div>
    <div id="resultsContent"></div>
    <div id="locationInfo" class="location-pill hidden">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span id="locationText"></span>
    </div>
  </div>
</div>

<!-- ─── PAGE: BATCH ─── -->
<div id="page-batch" class="page">
  <div class="card">
    <div class="card-header">
      <span class="card-title">Batch Transform</span>
      <span class="text-sm text-muted">Paste coordinates below</span>
    </div>
    <div class="field">
      <label class="field-label">Direction</label>
      <div class="seg-control" id="batchDirSeg">
        <button class="seg-btn active" data-value="WGS84_TO_GRID" onclick="setBatchDir(this)">WGS → Grid</button>
        <button class="seg-btn" data-value="GRID_TO_WGS84" onclick="setBatchDir(this)">Grid → WGS</button>
      </div>
    </div>
    <div class="field">
      <label class="field-label">Coordinates (one per line: lat,lon or easting,northing)</label>
      <textarea id="batchInput" class="batch-textarea" placeholder="5.5560, -0.1850&#10;6.6884, -1.6244&#10;9.4034, -0.8393"></textarea>
    </div>
    <button class="btn btn-primary btn-full mt-3" onclick="doBatch()">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="M7 8h10M7 12h6M7 16h8"/></svg>
      Transform Batch
    </button>
  </div>
  <div id="batchResultsCard" class="card hidden">
    <div class="card-header">
      <span class="card-title">Results</span>
      <div class="flex gap-2">
        <button class="btn btn-sm btn-outline" onclick="copyBatchResults()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Copy
        </button>
      </div>
    </div>
    <div id="batchResultsBody" class="batch-results"></div>
  </div>
</div>

<!-- ─── PAGE: CALIBRATE ─── -->
<div id="page-calibrate" class="page">
  <div class="card">
    <div class="card-header">
      <span class="card-title">Local Calibration</span>
      <span id="calStatusBadge" class="card-badge badge-info">Not Calibrated</span>
    </div>
    <p class="text-sm text-sec mb-2">Enter known control points to derive a 7-Parameter Helmert Transformation. Minimum 3 points required.</p>
    <table class="cp-table">
      <thead>
        <tr><th>#</th><th>WGS Lat</th><th>WGS Lon</th><th>Grid E</th><th>Grid N</th></tr>
      </thead>
      <tbody id="cpBody">
        <tr><td class="text-muted text-sm">1</td><td><input type="number" step="any" placeholder="5.6037"></td><td><input type="number" step="any" placeholder="-0.1870"></td><td><input type="number" step="any" placeholder="274319"></td><td><input type="number" step="any" placeholder="615007"></td></tr>
        <tr><td class="text-muted text-sm">2</td><td><input type="number" step="any" placeholder="6.6884"></td><td><input type="number" step="any" placeholder="-1.6244"></td><td><input type="number" step="any" placeholder="415000"></td><td><input type="number" step="any" placeholder="740000"></td></tr>
        <tr><td class="text-muted text-sm">3</td><td><input type="number" step="any" placeholder="9.4034"></td><td><input type="number" step="any" placeholder="-0.8393"></td><td><input type="number" step="any" placeholder="300000"></td><td><input type="number" step="any" placeholder="880000"></td></tr>
      </tbody>
    </table>
    <button class="btn btn-sm btn-ghost mt-2" onclick="addCpRow()">+ Add Point</button>
    <div class="cp-actions">
      <button class="btn btn-primary" onclick="doCalibrate()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        Run Calibration
      </button>
      <button class="btn btn-outline" onclick="clearCalibration()">Clear</button>
    </div>
  </div>
  <div id="calResultsCard" class="card hidden">
    <div class="card-header"><span class="card-title">Calibration Result</span></div>
    <div id="calResultsContent"></div>
  </div>
</div>

<!-- ─── PAGE: SETTINGS ─── -->
<div id="page-settings" class="page">
  <div class="card">
    <div class="card-header"><span class="card-title">Appearance</span></div>
    <div class="setting-item">
      <div>
        <div class="setting-label">Theme</div>
        <div class="setting-desc">Switch between dark and light mode</div>
      </div>
      <div class="seg-control" id="themeSeg">
        <button class="seg-btn" data-value="dark" onclick="setTheme('dark')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <button class="seg-btn" data-value="light" onclick="setTheme('light')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/></svg>
        </button>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><span class="card-title">Transformation</span></div>
    <div class="setting-item">
      <div>
        <div class="setting-label">Method</div>
        <div class="setting-desc" id="methodDesc">NGA Geocentric — ~6m accuracy</div>
      </div>
      <div class="setting-action">
        <select id="methodSelect" style="height:36px;padding:0 24px 0 10px;background:var(--s2);border:1px solid var(--s3);border-radius:6px;color:var(--t1);font-size:12px;appearance:none;cursor:pointer" onchange="switchMethod(this.value)">
          <option value="EPSG:6896">NGA Geocentric</option>
          <option value="EPSG:1569">OS Military</option>
          <option value="CUSTOM">Custom 7-Param</option>
        </select>
      </div>
    </div>
    <div class="setting-item">
      <div>
        <div class="setting-label">Decimal Places</div>
        <div class="setting-desc">Coordinate output precision</div>
      </div>
      <div class="setting-action">
        <div class="seg-control" id="dpSeg">
          <button class="seg-btn" data-value="4" onclick="setDecimals(4)">4</button>
          <button class="seg-btn active" data-value="6" onclick="setDecimals(6)">6</button>
          <button class="seg-btn" data-value="8" onclick="setDecimals(8)">8</button>
        </div>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><span class="card-title">About</span></div>
    <div class="setting-item">
      <div>
        <div class="setting-label">Geodetic Knife</div>
        <div class="setting-desc">Ghana Geodetic Transformation Tool</div>
        <div class="setting-desc">WGS84 · GNG · GMG · Helmert 7-Param</div>
      </div>
    </div>
    <div class="setting-item">
      <div>
        <div class="setting-label">PWA Install</div>
        <div class="setting-desc">Add to home screen for offline use</div>
      </div>
      <div class="setting-action">
        <button class="btn btn-sm btn-outline" onclick="installPWA()">Install</button>
      </div>
    </div>
  </div>
</div>

</main>

<!-- ═══════ BOTTOM NAV ═══════ -->
<nav class="bottom-nav">
  <button class="nav-item active" data-page="transform" onclick="switchPage('transform')">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
    Transform
  </button>
  <button class="nav-item" data-page="batch" onclick="switchPage('batch')">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="M7 8h10M7 12h6M7 16h8"/></svg>
    Batch
  </button>
  <button class="nav-item" data-page="calibrate" onclick="switchPage('calibrate')">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
    Calibrate
  </button>
  <button class="nav-item" data-page="settings" onclick="switchPage('settings')">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
    Settings
  </button>
</nav>

<!-- ═══════ TOAST ═══════ -->
<div id="toast" class="toast"></div>

<!-- ═══════ JAVASCRIPT ═══════ -->
<script>
(function(){
'use strict';

/* ── STATE ── */
let state = {
  srcCrs: 'WGS84',
  tgtCrs: 'GNG',
  batchDir: 'WGS84_TO_GRID',
  decimals: 6,
  theme: localStorage.getItem('geodetic_theme') || 'dark',
  calibration: JSON.parse(localStorage.getItem('geodetic_cal') || 'null'),
  lastResult: null,
  currentPage: 'transform',
  swiped: false
};

/* ── INIT ── */
function init() {
  applyTheme(state.theme);
  updateCalStatus();
  updateMethodBadge();
  // Check online status
  window.addEventListener('online', () => setOnline(true));
  window.addEventListener('offline', () => setOnline(false));
  // Fetch calibration status from server
  fetch('/api/calibration_status').then(r => r.json()).then(d => {
    if (d && d.is_calibrated) {
      state.calibration = d;
      localStorage.setItem('geodetic_cal', JSON.stringify(d));
      updateCalStatus();
      updateMethodBadge();
    }
  }).catch(() => {});
}

/* ── THEME ── */
function applyTheme(t) {
  state.theme = t;
  localStorage.setItem('geodetic_theme', t);
  document.documentElement.setAttribute('data-theme', t === 'light' ? 'light' : '');
  document.querySelector('meta[name="theme-color"]').content = t === 'light' ? '#F9FAFB' : '#0F1117';
  // Update theme icon
  const icon = document.getElementById('themeIcon');
  if (icon) {
    icon.innerHTML = t === 'light'
      ? '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>'
      : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
  }
  // Update settings seg control
  document.querySelectorAll('#themeSeg .seg-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.value === t);
  });
}

window.toggleTheme = function() {
  applyTheme(state.theme === 'dark' ? 'light' : 'dark');
};
window.setTheme = function(t) {
  applyTheme(t);
};

/* ── NAVIGATION ── */
window.switchPage = function(page) {
  state.currentPage = page;
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-' + page).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n => {
    n.classList.toggle('active', n.dataset.page === page);
  });
};

/* ── SOURCE CRS ── */
window.setSrcCrs = function(btn) {
  state.srcCrs = btn.dataset.value;
  document.querySelectorAll('#srcCrsChips .chip').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  // Show/hide appropriate inputs
  const isWgs = state.srcCrs === 'WGS84';
  document.getElementById('wgs84Inputs').classList.toggle('hidden', !isWgs);
  document.getElementById('gridInputs').classList.toggle('hidden', isWgs);
  // Auto-set target to opposite
  if (isWgs) {
    state.tgtCrs = 'GNG';
    document.querySelectorAll('#tgtCrsChips .chip').forEach(c => c.classList.toggle('active', c.dataset.value === 'GNG'));
    document.getElementById('targetLabel').textContent = 'GNG Grid';
  } else {
    state.tgtCrs = 'WGS84';
    document.querySelectorAll('#tgtCrsChips .chip').forEach(c => c.classList.toggle('active', c.dataset.value === 'WGS84'));
    document.getElementById('targetLabel').textContent = 'WGS 84';
  }
};

/* ── TARGET CRS ── */
window.setTgtCrs = function(btn) {
  state.tgtCrs = btn.dataset.value;
  document.querySelectorAll('#tgtCrsChips .chip').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('targetLabel').textContent = state.tgtCrs === 'WGS84' ? 'WGS 84' : state.tgtCrs + ' Grid';
};

/* ── SWAP ── */
window.swapDatum = function() {
  const btn = document.querySelector('.swap-btn');
  btn.classList.toggle('rotated');
  setTimeout(() => btn.classList.remove('rotated'), 400);
  // Swap source/target
  const prevSrc = state.srcCrs;
  const prevTgt = state.tgtCrs;
  // If last result exists, populate inputs
  if (state.lastResult) {
    if (prevSrc === 'WGS84' && state.lastResult.wgs84) {
      document.getElementById('latInput').value = state.lastResult.wgs84.lat;
      document.getElementById('lonInput').value = state.lastResult.wgs84.lon;
    } else if (state.lastResult[prevTgt.toLowerCase()]) {
      const grid = state.lastResult[prevTgt.toLowerCase()];
      document.getElementById('eastingInput').value = grid.easting;
      document.getElementById('northingInput').value = grid.northing;
    }
  }
  // Switch src to previous target
  state.srcCrs = prevTgt;
  state.tgtCrs = prevSrc;
  // Update chip UI
  document.querySelectorAll('#srcCrsChips .chip').forEach(c => c.classList.toggle('active', c.dataset.value === state.srcCrs));
  document.querySelectorAll('#tgtCrsChips .chip').forEach(c => c.classList.toggle('active', c.dataset.value === state.tgtCrs));
  const isWgs = state.srcCrs === 'WGS84';
  document.getElementById('wgs84Inputs').classList.toggle('hidden', !isWgs);
  document.getElementById('gridInputs').classList.toggle('hidden', isWgs);
  document.getElementById('targetLabel').textContent = state.tgtCrs === 'WGS84' ? 'WGS 84' : state.tgtCrs + ' Grid';
};

/* ── GPS ── */
window.useGPS = function() {
  if (!navigator.geolocation) {
    toast('Geolocation not supported', 'err');
    return;
  }
  const btn = document.getElementById('gpsBtn');
  btn.classList.add('loading');
  navigator.geolocation.getCurrentPosition(
    pos => {
      document.getElementById('latInput').value = pos.coords.latitude.toFixed(6);
      document.getElementById('lonInput').value = pos.coords.longitude.toFixed(6);
      btn.classList.remove('loading');
      toast('GPS location acquired', 'ok');
    },
    err => {
      btn.classList.remove('loading');
      toast('GPS error: ' + err.message, 'err');
    },
    { enableHighAccuracy: true, timeout: 10000 }
  );
};

/* ── TRANSFORM ── */
window.doTransform = async function() {
  let mode, body = {};

  if (state.srcCrs === 'WGS84') {
    mode = 'WGS84_TO_GRID';
    body.lat = parseFloat(document.getElementById('latInput').value);
    body.lon = parseFloat(document.getElementById('lonInput').value);
    if (isNaN(body.lat) || isNaN(body.lon)) {
      toast('Enter valid coordinates', 'err');
      document.getElementById('latInput').classList.add('invalid');
      document.getElementById('lonInput').classList.add('invalid');
      setTimeout(() => {
        document.getElementById('latInput').classList.remove('invalid');
        document.getElementById('lonInput').classList.remove('invalid');
      }, 400);
      return;
    }
    if (body.lat < -90 || body.lat > 90) { toast('Latitude out of range (-90 to 90)', 'err'); return; }
    if (body.lon < -180 || body.lon > 180) { toast('Longitude out of range (-180 to 180)', 'err'); return; }
    document.getElementById('latInput').classList.add('valid');
    document.getElementById('lonInput').classList.add('valid');
    setTimeout(() => {
      document.getElementById('latInput').classList.remove('valid');
      document.getElementById('lonInput').classList.remove('valid');
    }, 1500);
  } else {
    mode = state.srcCrs === 'GNG' ? 'GNG_GMG' : 'GNG_GMG';
    body.easting = parseFloat(document.getElementById('eastingInput').value);
    body.northing = parseFloat(document.getElementById('northingInput').value);
    body.from_crs = state.srcCrs;
    if (state.tgtCrs === 'WGS84') mode = 'GRID_TO_WGS84';
    if (isNaN(body.easting) || isNaN(body.northing)) {
      toast('Enter valid grid coordinates', 'err'); return;
    }
  }

  body.mode = mode;
  // Inject calibration if available
  if (state.calibration && state.calibration.towgs84) {
    body.calibration = { towgs84: state.calibration.towgs84 };
  }

  const btn = document.getElementById('transformBtn');
  btn.disabled = true;
  btn.innerHTML = '<svg class="skeleton" viewBox="0 0 24 24" width="18" height="18" style="border-radius:50%"></svg> Transforming...';

  try {
    const res = await fetch('/api/convert', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    const data = await res.json();
    if (data.error) { toast(data.error, 'err'); return; }

    state.lastResult = data;
    renderResult(data);
    // Geocode
    if (data.wgs84) {
      try {
        const geo = await fetch('/api/geocode?lat=' + data.wgs84.lat + '&lon=' + data.wgs84.lon);
        const gd = await geo.json();
        if (gd.display_name) {
          document.getElementById('locationInfo').classList.remove('hidden');
          document.getElementById('locationText').textContent = gd.display_name;
        }
      } catch(e) {}
    }
  } catch(e) {
    toast('Network error — check connection', 'err');
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg> Transform';
  }
};

function renderResult(data) {
  const card = document.getElementById('resultsCard');
  const content = document.getElementById('resultsContent');
  const dp = state.decimals;

  // Accuracy badge
  const accBadge = document.getElementById('accuracyBadge');
  if (data.accuracy) {
    const acc = parseFloat(data.accuracy.horizontal_accuracy_meters);
    accBadge.textContent = '~' + (isNaN(acc) ? '6m' : acc + 'm');
    accBadge.className = 'card-badge ' + (acc < 1 ? 'badge-ok' : acc < 5 ? 'badge-warn' : 'badge-err');
  }

  let html = '';
  // KPI grid
  html += '<div class="kpi-grid">';
  if (data.wgs84) {
    html += '<div class="kpi"><div class="kpi-label">Latitude</div><div class="kpi-val">' + data.wgs84.lat.toFixed(dp) + '<span class="kpi-unit">°</span></div></div>';
    html += '<div class="kpi"><div class="kpi-label">Longitude</div><div class="kpi-val">' + data.wgs84.lon.toFixed(dp) + '<span class="kpi-unit">°</span></div></div>';
  }
  if (data.gng) {
    html += '<div class="kpi"><div class="kpi-label">GNG E</div><div class="kpi-val">' + data.gng.easting.toFixed(2) + '<span class="kpi-unit">ft</span></div></div>';
    html += '<div class="kpi"><div class="kpi-label">GNG N</div><div class="kpi-val">' + data.gng.northing.toFixed(2) + '<span class="kpi-unit">ft</span></div></div>';
  }
  html += '</div>';

  // Detail rows
  function row(label, val, unit) {
    return '<div class="result-row"><span class="result-label">' + label + '</span><div class="result-val"><span>' + val + '</span><button class="copy-btn" onclick="copyVal(this,\'' + val + '\')" title="Copy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div><span class="result-unit">' + unit + '</span></div>';
  }

  if (data.gng) {
    html += row('GNG E', data.gng.easting.toFixed(2), 'ft');
    html += row('GNG N', data.gng.northing.toFixed(2), 'ft');
  }
  if (data.gmg) {
    html += row('GMG E', data.gmg.easting.toFixed(3), 'm');
    html += row('GMG N', data.gmg.northing.toFixed(3), 'm');
  }
  if (data.wgs84) {
    html += row('Lat', data.wgs84.lat.toFixed(dp), '°');
    html += row('Lon', data.wgs84.lon.toFixed(dp), '°');
  }

  // Method info
  if (data.accuracy) {
    html += '<div class="result-row" style="border-top:1px solid var(--s2);margin-top:4px;padding-top:12px">';
    html += '<span class="result-label">Method</span>';
    html += '<span class="text-xs text-sec">' + (data.accuracy.method || data.accuracy.active_method || '—') + '</span>';
    html += '</div>';
  }

  content.innerHTML = html;
  card.classList.remove('hidden');
  // Scroll to result
  card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

window.copyVal = function(btn, val) {
  navigator.clipboard.writeText(val).then(() => {
    btn.classList.add('copied');
    btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>';
    setTimeout(() => {
      btn.classList.remove('copied');
      btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    }, 1500);
  });
};

/* ── BATCH ── */
window.setBatchDir = function(btn) {
  state.batchDir = btn.dataset.value;
  document.querySelectorAll('#batchDirSeg .seg-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
};

window.doBatch = async function() {
  const text = document.getElementById('batchInput').value.trim();
  if (!text) { toast('Paste coordinates first', 'err'); return; }
  const lines = text.split('\n').filter(l => l.trim());
  const points = [];
  for (const line of lines) {
    const parts = line.split(/[,\s\t]+/).map(s => parseFloat(s.trim()));
    if (parts.length >= 2 && !isNaN(parts[0]) && !isNaN(parts[1])) {
      const p = { mode: state.batchDir };
      if (state.batchDir === 'WGS84_TO_GRID') {
        p.lat = parts[0]; p.lon = parts[1];
      } else {
        p.easting = parts[0]; p.northing = parts[1]; p.from_crs = 'GNG';
      }
      points.push(p);
    }
  }
  if (points.length === 0) { toast('No valid coordinates found', 'err'); return; }

  const body = { points };
  if (state.calibration && state.calibration.towgs84) {
    body.calibration = { towgs84: state.calibration.towgs84 };
  }

  try {
    const res = await fetch('/api/convert_batch', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    const data = await res.json();
    renderBatchResults(data);
  } catch(e) {
    toast('Batch failed: ' + e.message, 'err');
  }
};

function renderBatchResults(data) {
  const card = document.getElementById('batchResultsCard');
  const body = document.getElementById('batchResultsBody');
  const dp = state.decimals;

  if (data.results) {
    let html = '';
    data.results.forEach((r, i) => {
      let coord = '';
      if (r.wgs84) coord = r.wgs84.lat.toFixed(dp) + ', ' + r.wgs84.lon.toFixed(dp);
      else if (r.gng) coord = 'E: ' + r.gng.easting.toFixed(2) + ' N: ' + r.gng.northing.toFixed(2);
      html += '<div class="batch-row"><span class="batch-idx">' + (i + 1) + '</span><span class="batch-coord">' + coord + '</span></div>';
    });
    body.innerHTML = html;
  }
  if (data.errors && data.errors.length) {
    body.innerHTML += '<div class="text-sm text-sec mt-2">' + data.errors.length + ' errors</div>';
  }
  card.classList.remove('hidden');
}

window.copyBatchResults = function() {
  const text = document.getElementById('batchResultsBody').innerText;
  navigator.clipboard.writeText(text).then(() => toast('Copied!', 'ok'));
};

/* ── CALIBRATION ── */
window.addCpRow = function() {
  const tbody = document.getElementById('cpBody');
  const n = tbody.rows.length + 1;
  const tr = document.createElement('tr');
  tr.innerHTML = '<td class="text-muted text-sm">' + n + '</td><td><input type="number" step="any"></td><td><input type="number" step="any"></td><td><input type="number" step="any"></td><td><input type="number" step="any"></td>';
  tbody.appendChild(tr);
};

window.doCalibrate = async function() {
  const rows = document.querySelectorAll('#cpBody tr');
  const points = [];
  rows.forEach(row => {
    const inputs = row.querySelectorAll('input');
    const vals = Array.from(inputs).map(i => parseFloat(i.value));
    if (vals.filter(v => !isNaN(v)).length >= 4) {
      points.push({
        wgs84: { lat: vals[0], lon: vals[1] },
        gmg: { easting: vals[2], northing: vals[3] }
      });
    }
  });
  if (points.length < 3) { toast('Need at least 3 valid control points', 'err'); return; }

  try {
    const res = await fetch('/api/calibrate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ points })
    });
    const data = await res.json();
    if (data.error) { toast(data.error, 'err'); return; }

    state.calibration = data;
    localStorage.setItem('geodetic_cal', JSON.stringify(data));
    updateCalStatus();
    updateMethodBadge();
    renderCalResult(data);
    toast('Calibration applied!', 'ok');
  } catch(e) {
    toast('Calibration failed: ' + e.message, 'err');
  }
};

function renderCalResult(data) {
  const card = document.getElementById('calResultsCard');
  const content = document.getElementById('calResultsContent');
  const p = data.towgs84 || [];
  const r = data.residuals || {};
  const labels = ['dX (m)', 'dY (m)', 'dZ (m)', 'rX (")', 'rY (")', 'rZ (")', 'Scale (ppm)'];

  let html = '<div class="kpi-grid">';
  html += '<div class="kpi"><div class="kpi-label">Points</div><div class="kpi-val">' + (r.num_points || p.length) + '</div></div>';
  html += '<div class="kpi"><div class="kpi-label">Avg Residual</div><div class="kpi-val" style="color:var(--ok)">' + (r.average_m || 0).toFixed(3) + '<span class="kpi-unit">m</span></div></div>';
  html += '<div class="kpi"><div class="kpi-label">Max Residual</div><div class="kpi-val" style="color:' + ((r.max_m || 0) < 0.5 ? 'var(--ok)' : 'var(--warn)') + '">' + (r.max_m || 0).toFixed(3) + '<span class="kpi-unit">m</span></div></div>';
  html += '<div class="kpi"><div class="kpi-label">RMS</div><div class="kpi-val">' + (r.average_m || 0).toFixed(3) + '<span class="kpi-unit">m</span></div></div>';
  html += '</div>';

  html += '<div class="card-title mb-2">7 Parameters</div>';
  html += '<div class="param-grid">';
  p.forEach((v, i) => {
    html += '<div class="param-item"><div class="p-label">' + (labels[i] || 'P' + i) + '</div><div class="p-val">' + (typeof v === 'number' ? v.toFixed(6) : v) + '</div></div>';
  });
  html += '</div>';

  if (r.per_point_m) {
    html += '<div class="card-title mt-3 mb-2">Residuals per Point</div>';
    r.per_point_m.forEach((v, i) => {
      const cls = v < 0.3 ? 'residual-good' : v < 1 ? 'residual-warn' : 'residual-bad';
      html += '<div class="result-row"><span class="result-label">Point ' + (i + 1) + '</span><span class="result-val ' + cls + '">' + v.toFixed(4) + ' m</span></div>';
    });
  }

  content.innerHTML = html;
  card.classList.remove('hidden');
}

window.clearCalibration = function() {
  state.calibration = null;
  localStorage.removeItem('geodetic_cal');
  updateCalStatus();
  updateMethodBadge();
  document.getElementById('calResultsCard').classList.add('hidden');
  toast('Calibration cleared', 'info');
  // Tell server to reset
  fetch('/api/method', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ method: 'EPSG:6896' })
  }).catch(() => {});
};

function updateCalStatus() {
  const badge = document.getElementById('calStatusBadge');
  if (state.calibration && state.calibration.towgs84) {
    badge.textContent = 'Calibrated';
    badge.className = 'card-badge badge-ok';
  } else {
    badge.textContent = 'Not Calibrated';
    badge.className = 'card-badge badge-info';
  }
}

function updateMethodBadge() {
  const badge = document.getElementById('methodBadge');
  if (state.calibration && state.calibration.towgs84) {
    badge.textContent = '7-Param';
    badge.className = 'card-badge badge-ok';
  } else {
    badge.textContent = 'EPSG:6896';
    badge.className = 'card-badge badge-info';
  }
}

/* ── METHOD SWITCH ── */
window.switchMethod = async function(m) {
  try {
    await fetch('/api/method', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ method: m })
    });
    updateMethodBadge();
    toast('Method switched to ' + m, 'ok');
  } catch(e) {
    toast('Failed to switch method', 'err');
  }
};

/* ── DECIMALS ── */
window.setDecimals = function(d) {
  state.decimals = parseInt(d);
  document.querySelectorAll('#dpSeg .seg-btn').forEach(b => b.classList.toggle('active', b.dataset.value === d));
  if (state.lastResult) renderResult(state.lastResult);
};

/* ── ONLINE STATUS ── */
function setOnline(isOnline) {
  const pill = document.getElementById('statusPill');
  pill.className = 'status-pill ' + (isOnline ? 'status-online' : 'status-offline');
  pill.innerHTML = '<span class="status-dot"></span>' + (isOnline ? 'Online' : 'Offline');
}

/* ── TOAST ── */
function toast(msg, type) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = 'toast toast-' + (type || 'info') + ' show';
  clearTimeout(el._timer);
  el._timer = setTimeout(() => el.classList.remove('show'), 2500);
}
window.toast = toast;

/* ── PWA ── */
let deferredPrompt;
window.addEventListener('beforeinstallprompt', e => {
  e.preventDefault();
  deferredPrompt = e;
});
window.installPWA = function() {
  if (deferredPrompt) {
    deferredPrompt.prompt();
    deferredPrompt.userChoice.then(r => { deferredPrompt = null; });
  } else {
    toast('Use browser menu → "Add to Home Screen"', 'info');
  }
};

/* ── GO ── */
init();

})();
</script>
</body>
</html>
